# Ideally you NEVER COMMIT THESE VALUES TO GIT (although if all passwords are
# automatically generated inside the vault this should not really matter)

# If this is your first time using secrets in Validated Patterns, please check out the following links for a guide:
# https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
# https://validatedpatterns.io/learn/getting-started-secret-management/#_adding_a_secret_to_the_multicloud_gitops_pattern

version: "2.0"

backingStore: vault

secrets:
  # --- SSH key for sandbox provisioning ---
  # Generate with: make generate-keys
  - name: ssh
    fields:
    - name: private_key
      path: ~/.generated-ssh-keys/sandbox-ssh
    - name: public_key
      path: ~/.generated-ssh-keys/sandbox-ssh.pub

  # --- Inference provider ---
  # The default SAW-BOM profile (charts/saw-bom/profiles/data-science) uses
  # NVIDIA (build.nvidia.com): provider `build`, model below. The installer
  # refuses a key whose `provider` doesn't match the profile's provider, so
  # change the profile too if you use another provider.
  - name: inference
    fields:
    - name: provider
      value: build
    - name: model
      value: nvidia/nemotron-3-super-120b-a12b
    - name: api_key
      path: ~/.nvidia-api-key
  # Custom OpenAI-compatible endpoint (vLLM, Ollama, ...): set saw-bom
  # `profiles: [custom-inference]` and use these fields instead. OpenShell
  # uses an `openai` provider with this base URL (see docs/custom-inference.md):
  #   - name: provider
  #     value: openai
  #   - name: model
  #     value: meta-llama/Llama-3.1-8B-Instruct
  #   - name: url
  #     value: https://vllm.models.svc.cluster.local:8443/v1
  #   - name: api_key
  #     path: ~/.custom-inference-api-key   # any non-empty value if the server needs no key

  # --- Web search ---
  # The default profile creates a `brave` provider in the default workspace,
  # so this key is required. With governance on, the brave profile is served
  # by the governance interceptor.
  - name: web-search
    fields:
    - name: provider
      value: brave
    - name: api_key
      path: ~/.brave-api-key

  # --- Keycloak test users (charts/openshell-keycloak) ---
  # Their passwords, generated on first load (20 characters with upper,
  # lower, digit and special). The realm import reads them; there are no
  # default passwords. Show them: make -f Makefile-quickstart keycloak-passwords
  - name: keycloak-users
    fields:
    - name: developer
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    - name: admin
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    - name: alice
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    - name: bob
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy

  # --- Self-service portal (charts/openshell-rhdh) ---
  # RHDH's Keycloak client secret and session secret, generated on first
  # load. The portal writes each user's own keys under hub/saw-<user>.
  - name: rhdh-oidc
    fields:
    - name: client_secret
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    - name: session_secret
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy

  # --- Per-user Vault prefix (optional) ---
  # Secrets above go to the shared hub prefix (secret/data/hub) and every
  # user's workspace reads them. The saw-users chart cannot create Vault
  # entries. To give one person their own keys, load them here (vaultPrefixes
  # is relative to secret/data) and set that user's vaultPrefix to
  # secret/data/hub/saw-<user>:
  # - name: inference
  #   vaultPrefixes:
  #     - hub/saw-alice
  #   fields:
  #   - name: provider
  #     value: build
  #   - name: model
  #     value: nvidia/nemotron-3-super-120b-a12b
  #   - name: api_key
  #     path: ~/.nvidia-api-key
