        gateway-build gateway-build-docker gateway-build-podman images-mirror \
        governance-interceptor-build governance-interceptor-build-local \
        keycloak-deploy keycloak-delete keycloak-check keycloak-issuer \
        keycloak-register keycloak-redirects keycloak-redirects-sync \
        keycloak-passwords keycloak-harden keycloak-add-users keycloak-password keycloak-reset-password \
        login whoami logout saw-create saw-configure saw-list saw-logs saw-status \
        saw-restart saw-vm-ssh saw-ssh saw-tui saw-gui saw-delete \
        sandbox-pre-delete quickstart-delete status test test-deployment test-harness-e2e lint \
        governance-profile-list governance-profile-add governance-profile-remove \
        governance-profile-create governance-deploy governance-delete governance-demo portal-vault-setup sandbox-ui \
        nemoclaw-tui openclaw-tui nemoclaw-gui openclaw-gui \
        clean-stale-operators pre-uninstall uninstall pattern-uninstall \
        .check-saw-name .check-ssh-key .check-gateway-ca .check-prereqs

##@ Setup and Images

prereqs-check: .check-prereqs ## Check tools and cluster capacity before Pattern install

quickstart-prereqs-check: ## Check tools, capacity, CNV, and RHBK before quickstart
	@PREREQS_MODE=quickstart $(SCRIPTS_DIR)/prereqs-check.sh

ssh-key-generate: ## Generate or recover the SSH public key without replacing the private key
	@$(SCRIPTS_DIR)/generate-keys.sh

# --- NemoClaw images ---

sandbox-build: ## Build the sandbox image and push to Quay (OTEL=1 enables diagnostics)
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	@oc delete is nemoclaw-sandbox -n "$(BUILD_NS)" --ignore-not-found=true
	helm upgrade --install nemoclaw-imagestream $(HELM_DIR)nemoclaw-imagestream \
		--namespace $(BUILD_NS) --create-namespace \
		$(if $(filter 1,$(OTEL)),--set build.otelEnabled=1)
	oc start-build nemoclaw-sandbox -n $(BUILD_NS) --follow
	@echo "Pushing nemoclaw-sandbox to $(QUAY_REPO)..."
	@$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) nemoclaw-sandbox $(QUAY_REPO) $(OPENSHELL_VERSION)

cli-build: ## Build the NemoClaw CLI image and push to Quay
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	@oc delete is nemoclaw-cli -n "$(BUILD_NS)" --ignore-not-found=true
	helm upgrade --install nemoclaw-cli-imagestream $(HELM_DIR)nemoclaw-cli-imagestream \
		--namespace $(BUILD_NS) --create-namespace
	oc start-build nemoclaw-cli -n $(BUILD_NS) --follow
	@echo "Pushing nemoclaw-cli to $(QUAY_REPO)..."
	@$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) nemoclaw-cli $(QUAY_REPO) $(OPENSHELL_VERSION)

# --- Governance interceptor image ---

governance-interceptor-build: ## Build the governance interceptor image and push to Quay
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	@oc delete is governance-interceptor -n "$(BUILD_NS)" --ignore-not-found=true
	helm upgrade --install governance-interceptor-image $(HELM_DIR)governance-interceptor-image \
		--namespace $(BUILD_NS) --create-namespace
	oc start-build governance-interceptor -n $(BUILD_NS) --follow
	@echo "The build pushed $$(helm get values governance-interceptor-image -n $(BUILD_NS) -a -o json | jq -r .output.externalImage)"

governance-interceptor-build-local: ## Build the governance interceptor image in the cluster
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	helm upgrade --install governance-interceptor-image $(HELM_DIR)governance-interceptor-image \
		--namespace $(BUILD_NS) --create-namespace \
		--set source.git.ref=$(OPENSHELL_INTERCEPTOR_REF) \
		--set output.imageStreamTag=governance-interceptor:v$(patsubst v%,%,$(OPENSHELL_INTERCEPTOR_REF))
	oc start-build governance-interceptor -n $(BUILD_NS) --follow

# --- Gateway VM image ---

gateway-build-docker: ## Build the Docker gateway image and push to Quay
	@echo "Building Docker gateway image (openshell-gateway-docker)..."
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	@oc delete dv openshell-gateway-docker-golden -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete datasource openshell-gateway-docker -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete pvc openshell-gateway-docker-golden -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete builds -l buildconfig=openshell-gateway-docker -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete is openshell-gateway-docker -n "$(BUILD_NS)" --ignore-not-found=true
	@resources=$$(oc api-resources --api-group=cdi.kubevirt.io -o name) || exit $$?; \
	GOLDEN_FLAG=""; \
	if ! printf '%s\n' "$$resources" | grep -q '^datavolumes.cdi.kubevirt.io$$'; then \
		GOLDEN_FLAG="--set goldenImage.enabled=false"; \
	fi; \
	helm upgrade --install openshell-gateway-docker-image $(HELM_DIR)openshell-gateway-image \
		--namespace $(BUILD_NS) --create-namespace $$GOLDEN_FLAG \
		--set containerRuntime=docker
	oc start-build openshell-gateway-docker -n $(BUILD_NS) --follow
	@echo "Pushing openshell-gateway-docker to $(QUAY_REPO)..."
	@$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) openshell-gateway-docker $(QUAY_REPO) $(OPENSHELL_VERSION)

gateway-build-podman: ## Build the Podman gateway image and push to Quay
	@echo "Building Podman gateway image (openshell-gateway)..."
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	@oc delete dv openshell-gateway-golden -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete datasource openshell-gateway -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete pvc openshell-gateway-golden -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete builds -l buildconfig=openshell-gateway -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete is openshell-gateway -n "$(BUILD_NS)" --ignore-not-found=true
	@resources=$$(oc api-resources --api-group=cdi.kubevirt.io -o name) || exit $$?; \
	GOLDEN_FLAG=""; \
	if ! printf '%s\n' "$$resources" | grep -q '^datavolumes.cdi.kubevirt.io$$'; then \
		GOLDEN_FLAG="--set goldenImage.enabled=false"; \
	fi; \
	helm upgrade --install openshell-gateway-image $(HELM_DIR)openshell-gateway-image \
		--namespace $(BUILD_NS) --create-namespace $$GOLDEN_FLAG \
		--set containerRuntime=podman
	oc start-build openshell-gateway -n $(BUILD_NS) --follow
	@echo "Pushing openshell-gateway to $(QUAY_REPO)..."
	@$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) openshell-gateway $(QUAY_REPO) $(OPENSHELL_VERSION)


gateway-build: ## Build the gateway with CONTAINER_RUNTIME=podman or docker
	@case "$$CONTAINER_RUNTIME" in podman|docker) ;; *) echo "Error: CONTAINER_RUNTIME must be podman or docker." >&2; exit 1;; esac
	@$(MAKE) "gateway-build-$$CONTAINER_RUNTIME"

images-mirror: ## Mirror prebuilt images from Quay to the internal registry
	@$(SCRIPTS_DIR)/images-mirror.sh

##@ Pattern Lifecycle

# Clean stale operator CRDs from a previous install that block reinstallation.
# CNV leaves CRDs with broken conversion webhooks; RHBK CSV races the OperatorGroup.
# Safe to run on a clean cluster (no-ops if nothing stale exists).
clean-stale-operators: ## Inspect stale CNV CRDs after operator cleanup
	@$(SCRIPTS_DIR)/inspect-stale-operators.sh

# Delete VMs, HyperConverged CR, and operator CRDs before uninstall so
# ArgoCD doesn't get stuck on webhook finalizers. OLM cleanup (Subscription/
# CSV/InstallPlan) is intentionally deferred to the uninstall target below,
# after the Ansible framework removes ArgoCD apps — otherwise ArgoCD
# immediately recreates the Subscription we just deleted.
pre-uninstall: ## Delete pattern VMs before framework uninstall
	@$(SCRIPTS_DIR)/pattern-cnv-mark.sh
	@$(SCRIPTS_DIR)/pattern-pipelines-mark.sh
	@$(SCRIPTS_DIR)/pattern-pre-uninstall.sh

# Generate SSH keys before install. No deletions — safe to run repeatedly.
pattern-install: ssh-key-generate

# Handle a missing pattern CR without changing the framework install target.
# OLM cleanup runs AFTER rhvp.cluster_utils.uninstall removes the ArgoCD apps
# (including the openshift-cnv app that manages the Subscription). This prevents
# ArgoCD from fighting the cleanup by immediately recreating deleted resources.
uninstall: pre-uninstall ## Uninstall the pattern, then clean operator state
	@if $(SCRIPTS_DIR)/pattern-exists.sh; then \
		$(ANSIBLE_RUN) rhvp.cluster_utils.uninstall; \
	else \
		rc=$$?; if [ "$$rc" -ne 1 ]; then exit "$$rc"; fi; \
		echo "Pattern CR not found — already uninstalled. Cleaning up namespace..."; \
		oc delete ns "$(NS)" --wait=false --ignore-not-found=true; \
	fi
	@echo "Cleaning OLM state for openshift-cnv to prevent stale InstallPlan on reinstall..."
	@$(SCRIPTS_DIR)/pattern-operator-cleanup.sh
	@$(SCRIPTS_DIR)/pattern-pipelines-cleanup.sh

pattern-uninstall: uninstall ## Uninstall the Validated Pattern

# Clean up a single sandbox's heavy resources before uninstall to prevent
# finalizer hangs. VMs and DataVolumes take time to terminate and block
# ArgoCD app deletion. Scoped to OPENSHELL_SAW_NAME only — NOT named
# "uninstall"/"pre-uninstall", since those names collide with the
# pre-existing `uninstall` target in Makefile-common (the one
# `./pattern.sh make uninstall` calls). Make merges prerequisite lists
# across repeated target definitions, so reusing that name here would
# silently attach this namespace-wide cleanup to every future call of the
# framework's own uninstall target, deleting every sandbox VM/DataVolume in
# a shared namespace instead of just this one.
sandbox-pre-delete: .check-saw-name ## Schedule deletion of a sandbox's VM and disk
	@$(SCRIPTS_DIR)/sandbox-pre-delete.sh

# --- Keycloak / OIDC ---

##@ Keycloak and Authentication

keycloak-deploy: ## Deploy Keycloak and its realm in KEYCLOAK_NS
	@$(SCRIPTS_DIR)/deploy-keycloak.sh

keycloak-passwords: ## List users with passwords stored in Keycloak Secrets
	@$(SCRIPTS_DIR)/keycloak-users.sh show

keycloak-harden: ## For a realm imported earlier: password policy, brute-force lockout, no self-registration, generated passwords for the test users
	@$(SCRIPTS_DIR)/keycloak-users.sh ensure
	@$(SCRIPTS_DIR)/keycloak-users.sh harden

USERS_FILE ?= overrides/saw-users.yaml
KC_USER    ?=
KC_USERS_ENV = KEYCLOAK_NS=$(KEYCLOAK_NS) KEYCLOAK_CHART=$(KEYCLOAK_CHART) KEYCLOAK_REALM=$(KEYCLOAK_REALM) KEYCLOAK_NAME=$(KEYCLOAK_NAME)

keycloak-add-users: ## Create missing Keycloak users and store passwords in a Secret (USERS_FILE=...)
	@$(SCRIPTS_DIR)/keycloak-users.sh add-users "$(USERS_FILE)"

keycloak-password: ## Show the Secret location for one user (KC_USER=alice)
	@if [ -z "$(KC_USER)" ]; then echo "Error: KC_USER is required. Pass KC_USER=alice." >&2; exit 1; fi
	@$(SCRIPTS_DIR)/keycloak-users.sh password "$(KC_USER)"

keycloak-reset-password: ## Reset one user's password in a Secret (KC_USER=alice)
	@if [ -z "$(KC_USER)" ]; then echo "Error: KC_USER is required. Pass KC_USER=alice." >&2; exit 1; fi
	@$(SCRIPTS_DIR)/keycloak-users.sh reset-password "$(KC_USER)"

# Web UI sign-in: each workspace's web UIs (the VM dashboard, each sandbox
# UI route) need their redirect URI on Keycloak's dashboard client. The
# redirect registrar (charts/openshell-keycloak, on by default) registers
# them; with it off, run keycloak-register once the workspace exists (it waits
# up to REDIRECT_WAIT seconds for its routes) and keycloak-redirects-sync after
# deleting workspaces. See README, "Web UI sign-in".
REDIRECT_WAIT ?= 600
KC_REDIRECTS_ENV = KEYCLOAK_NS=$(KEYCLOAK_NS) KEYCLOAK_REALM=$(KEYCLOAK_REALM) KEYCLOAK_NAME=$(KEYCLOAK_NAME) WAIT=$(REDIRECT_WAIT)

keycloak-register: ## Register a user's Keycloak account and web UI redirects (KC_USER=alice)
	@if [ -z "$(KC_USER)" ]; then echo "Error: KC_USER is required. Pass KC_USER=alice." >&2; exit 1; fi
	@printf 'users:\n  - name: %s\n' "$(KC_USER)" | $(KC_USERS_ENV) $(SCRIPTS_DIR)/keycloak-users.sh add-users -
	@$(KC_REDIRECTS_ENV) uv run --locked $(SCRIPTS_DIR)/keycloak-redirects.py register "$(KC_USER)"

keycloak-redirects: ## List the dashboard client's redirect URIs, and the web UI routes that have none yet
	@$(KC_REDIRECTS_ENV) uv run --locked $(SCRIPTS_DIR)/keycloak-redirects.py list

keycloak-redirects-sync: ## Register every workspace's web UI redirect URIs, and remove those of deleted workspaces
	@$(KC_REDIRECTS_ENV) uv run --locked $(SCRIPTS_DIR)/keycloak-redirects.py sync

keycloak-check: ## Check the Keycloak in KEYCLOAK_NS is configured for OpenShell (realm, CLI client, roles)
	@$(SCRIPTS_DIR)/keycloak-check.sh

keycloak-issuer: ## Print the Keycloak OIDC issuer URL
	@host=$$($(SCRIPTS_DIR)/keycloak-host.sh "$(KEYCLOAK_NS)") || exit 1; \
		echo "https://$${host}/realms/$(KEYCLOAK_REALM)"

login: ## Authenticate with the OIDC provider
	@NS="$(KEYCLOAK_NS)" \
	$(SCRIPTS_DIR)/oidc-login.sh login

whoami: ## Show current OIDC identity and token status
	@$(SCRIPTS_DIR)/oidc-login.sh whoami

logout: ## Revoke OIDC token and clear sandbox credentials
	@$(SCRIPTS_DIR)/oidc-login.sh logout
	@$(SCRIPTS_DIR)/openshell-saw-logout.sh

keycloak-delete: ## Uninstall Keycloak and its database
	@$(SCRIPTS_DIR)/keycloak-delete.sh

# --- Sandbox ---

##@ Sandbox Operations

saw-create: .check-saw-name ## Provision one SAW (OPENSHELL_SAW_NAME is required)
	@$(SCRIPTS_DIR)/openshell-saw-create.sh

saw-configure: .check-saw-name ## Configure the OpenShell CLI for one gateway
	@$(SCRIPTS_DIR)/saw-configure.sh
# Keep the token saved by `openshell gateway add`. The separate make-login token
# may belong to another cluster and must not overwrite this gateway's login.

saw-list: ## List SAW virtual machines across namespaces
	@$(SCRIPTS_DIR)/saw-list.sh

saw-logs: .check-saw-name ## Follow the VM installer log
	oc -n "$(SAW_NS)" logs $(if $(filter false,$(FOLLOW)),,-f) \
		-l "vm.kubevirt.io/name=$(OPENSHELL_SAW_NAME)" -c guest-console-log --tail=-1

saw-status: .check-saw-name .check-ssh-key ## Show both installer phases from the VM
	@VM_NAME="$(OPENSHELL_SAW_NAME)" \
	$(SCRIPTS_DIR)/openshell-saw-vm-ssh.sh 'sudo cat /var/lib/saw/status.json'

saw-vm-ssh: .check-saw-name .check-ssh-key ## Open a VM shell (CMD= runs one command)
	@VM_NAME="$(OPENSHELL_SAW_NAME)" \
	$(SCRIPTS_DIR)/openshell-saw-vm-ssh.sh

# --- Harness bundles (skills, MCP servers, OpenClaw tool plugins) ---
# harness-bundles/<bundle>/ as an OCI image, mounted read-only at
# /sandbox/harness. HARNESS_BUNDLE=ds-default HARNESS_REPO=ghcr.io/<owner>/saw-harness-ds-default

HARNESS_BUNDLE ?= ds-default

.PHONY: harness-bundle-build harness-bundle-push
harness-bundle-build: ## Build harness-bundles/$(HARNESS_BUNDLE) as a local OCI image
	@$(SCRIPTS_DIR)/harness-bundle.sh build $(HARNESS_BUNDLE)

harness-bundle-push: ## Push harness-bundles/$(HARNESS_BUNDLE) to $(HARNESS_REPO) and print the harnessRef
	@test -n "$(HARNESS_REPO)" || { echo "set HARNESS_REPO, e.g. ghcr.io/<owner>/saw-harness-$(HARNESS_BUNDLE)"; exit 1; }
	@$(SCRIPTS_DIR)/harness-bundle.sh push $(HARNESS_BUNDLE) $(HARNESS_REPO)

saw-restart: .check-saw-name ## Restart the VM to apply a changed BOM or profile
	virtctl -n $(SAW_NS) restart $(OPENSHELL_SAW_NAME)

saw-ssh: .check-saw-name .check-gateway-ca ## Open a shell in a sandbox
	@$(SCRIPTS_DIR)/saw-ssh.sh

