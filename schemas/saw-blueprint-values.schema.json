{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {"sawBlueprint": {"type": "object", "additionalProperties": false, "properties": {
    "enabled": {"type": "boolean"}, "imageNamespace": {"$ref": "#/definitions/k8sName"},
    "deployerServiceAccount": {"$ref": "#/definitions/serviceAccount"}, "applicationSet": {"$ref": "#/definitions/applicationSet"},
    "platform": {"$ref": "#/definitions/platform"}, "installer": {"$ref": "#/definitions/installer"},
    "goldenImages": {"type": "array", "items": {"$ref": "#/definitions/goldenImage"}}, "tenants": {"type": "array", "items": {"$ref": "#/definitions/tenant"}}
  }, "required": ["enabled", "imageNamespace", "deployerServiceAccount", "applicationSet", "platform", "installer", "goldenImages", "tenants"]}},
  "required": ["sawBlueprint"],
  "definitions": {
    "k8sName": {"type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", "maxLength": 63},
    "serviceAccount": {"type": "object", "additionalProperties": false, "properties": {"name": {"$ref": "#/definitions/k8sName"}, "namespace": {"$ref": "#/definitions/k8sName"}}, "required": ["name", "namespace"]},
    "applicationSet": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "repoURL": {"type": "string", "maxLength": 2048}, "targetRevision": {"type": "string", "maxLength": 253}, "destinationServer": {"type": "string", "maxLength": 2048}, "project": {"type": "string", "maxLength": 253}, "tenantChartPath": {"type": "string", "pattern": "^[a-zA-Z0-9._/-]+$", "maxLength": 253}}, "required": ["enabled", "repoURL", "targetRevision", "destinationServer", "project", "tenantChartPath"]},
    "platform": {"type": "object", "additionalProperties": false, "properties": {"issuer": {"type": "string", "maxLength": 2048}, "vault": {"type": "object", "additionalProperties": false, "properties": {"server": {"type": "string", "maxLength": 2048}, "mount": {"type": "string", "maxLength": 253}, "prefix": {"type": "string", "maxLength": 512}, "authMount": {"type": "string", "maxLength": 253}, "audience": {"type": "string", "maxLength": 253}, "caBundle": {"type": "string", "maxLength": 65536}}, "required": ["server", "mount", "prefix", "authMount", "audience", "caBundle"]}}, "required": ["issuer", "vault"]},
    "component": {"type": "object", "additionalProperties": false, "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 128}, "image": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[0-9a-f]{64}$", "maxLength": 512}}, "required": ["version", "image"]},
    "bom": {"type": "object", "additionalProperties": false, "properties": {"installerVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "openshell": {"type": "object", "additionalProperties": false, "properties": {"cli": {"$ref": "#/definitions/component"}, "gateway": {"$ref": "#/definitions/component"}, "supervisor": {"$ref": "#/definitions/component"}}, "required": ["cli", "gateway", "supervisor"]}}, "required": ["installerVersion", "openshell"]},
    "installerRelease": {"type": "object", "additionalProperties": false, "properties": {"name": {"$ref": "#/definitions/k8sName"}, "bundleRef": {"type": "string", "pattern": "^[a-zA-Z0-9.-]+(/[a-z0-9._/-]+)?@sha256:[0-9a-f]{64}$", "maxLength": 2048}, "bundleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "bom": {"$ref": "#/definitions/bom"}}, "required": ["name", "bundleRef", "bundleDigest", "bom"]},
    "installer": {"type": "object", "additionalProperties": false, "properties": {"defaultRelease": {"$ref": "#/definitions/k8sName"}, "releases": {"type": "array", "items": {"$ref": "#/definitions/installerRelease"}}}, "required": ["defaultRelease", "releases"]},
    "goldenImage": {"type": "object", "additionalProperties": false, "properties": {"name": {"$ref": "#/definitions/k8sName"}, "registryURL": {"type": "string", "pattern": "^docker://[a-zA-Z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$", "maxLength": 2048}, "diskSizeGi": {"type": "integer", "minimum": 1, "maximum": 16384}, "storageClass": {"$ref": "#/definitions/k8sName"}, "registrySecret": {"$ref": "#/definitions/k8sName"}, "caConfigMap": {"$ref": "#/definitions/k8sName"}}, "required": ["name", "registryURL", "diskSizeGi"]},
    "credential": {"type": "object", "additionalProperties": false, "properties": {"name": {"$ref": "#/definitions/k8sName"}, "remoteKey": {"$ref": "#/definitions/k8sName"}, "keys": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*$"}}}, "required": ["name", "remoteKey", "keys"]},
    "instance": {"type": "object", "additionalProperties": false, "properties": {"workspaces": {"type": "array"}}, "required": ["workspaces"]},
    "profileConfigMap": {"type": "object", "additionalProperties": false, "properties": {"name": {"$ref": "#/definitions/k8sName"}, "data": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}}, "required": ["name", "data"]},
    "guest": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "cores": {"type": "integer", "minimum": 1, "maximum": 128}, "memoryGi": {"type": "integer", "minimum": 2, "maximum": 512}, "runStrategy": {"enum": ["Halted", "Always"]}}, "required": ["enabled"]},
    "tenant": {"type": "object", "additionalProperties": false, "properties": {"name": {"$ref": "#/definitions/k8sName"}, "subject": {"type": "string", "minLength": 1, "maxLength": 512}, "username": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"}, "vaultPrefix": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(/[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$", "maxLength": 512}, "credentials": {"type": "array", "items": {"$ref": "#/definitions/credential"}}, "goldenImageRef": {"$ref": "#/definitions/k8sName"}, "installerReleaseRef": {"$ref": "#/definitions/k8sName"}, "profileConfigMaps": {"type": "array", "items": {"$ref": "#/definitions/profileConfigMap"}}, "instance": {"$ref": "#/definitions/instance"}, "guest": {"$ref": "#/definitions/guest"}}, "required": ["name", "subject", "username", "credentials", "goldenImageRef", "instance"]}
  }
}
