##@ Pattern Lifecycle

# Clean stale operator CRDs from a previous install that block reinstallation.
# CNV leaves CRDs with broken conversion webhooks; RHBK CSV races the OperatorGroup.
# Safe to run on a clean cluster (no-ops if nothing stale exists).
clean-stale-operators: ## Inspect stale CNV CRDs after operator cleanup
	@$(SCRIPTS_DIR)/inspect-stale-operators.sh

# Delete VMs, HyperConverged CR, and operator CRDs before uninstall so
# ArgoCD doesn't get stuck on webhook finalizers. OLM cleanup (Subscription/
# CSV/InstallPlan) is intentionally deferred to the uninstall target below,
# after the Ansible framework removes ArgoCD apps — otherwise ArgoCD
# immediately recreates the Subscription we just deleted.
pre-uninstall: ## Delete pattern VMs before framework uninstall
	@$(SCRIPTS_DIR)/pattern-cnv-mark.sh
	@$(SCRIPTS_DIR)/pattern-pipelines-mark.sh
	@$(SCRIPTS_DIR)/pattern-pre-uninstall.sh

# Override install to generate the ssh keys and mirror images to internal registry
# before installing the pattern.
install: ssh-key-generate images-mirror

# Handle a missing pattern CR without changing the framework install target.
# OLM cleanup runs AFTER rhvp.cluster_utils.uninstall removes the ArgoCD apps
# (including the openshift-cnv app that manages the Subscription). This prevents
# ArgoCD from fighting the cleanup by immediately recreating deleted resources.
uninstall: pre-uninstall ## Uninstall the pattern, then clean operator state
	@if $(SCRIPTS_DIR)/pattern-exists.sh; then \
		$(ANSIBLE_RUN) rhvp.cluster_utils.uninstall; \
	else \
		rc=$$?; if [ "$$rc" -ne 1 ]; then exit "$$rc"; fi; \
		echo "Pattern CR not found — already uninstalled. Cleaning up namespace..."; \
		oc delete ns "$(NS)" --wait=false --ignore-not-found=true; \
	fi
	@echo "Cleaning OLM state for openshift-cnv to prevent stale InstallPlan on reinstall..."
	@$(SCRIPTS_DIR)/pattern-operator-cleanup.sh
	@$(SCRIPTS_DIR)/pattern-pipelines-cleanup.sh

pattern-uninstall: uninstall ## Uninstall the Validated Pattern

# Clean up one sandbox's VM and DataVolume before saw-delete. This target
# handles only OPENSHELL_SAW_NAME; pattern uninstall has its own cleanup.
sandbox-pre-delete: .check-saw-name ## Schedule deletion of a sandbox's VM and disk
	@$(SCRIPTS_DIR)/sandbox-pre-delete.sh

# --- Keycloak / OIDC ---

##@ Keycloak and Authentication

keycloak-deploy: ## Deploy Keycloak and its realm in KEYCLOAK_NS
	@DEMO_ENABLED=$(DEMO_ENABLED) $(SCRIPTS_DIR)/deploy-keycloak.sh

keycloak-passwords: ## List users with passwords stored in Keycloak Secrets
	@$(SCRIPTS_DIR)/keycloak-users.sh show

keycloak-harden: ## Apply password policy, lockout, and no self-registration to an existing realm
	@DEMO_ENABLED=$(DEMO_ENABLED) $(SCRIPTS_DIR)/keycloak-users.sh ensure
	@DEMO_ENABLED=$(DEMO_ENABLED) $(SCRIPTS_DIR)/keycloak-users.sh harden

USERS_FILE ?= overrides/saw-users.yaml
KC_USER    ?=
KC_USERS_ENV = KEYCLOAK_NS=$(KEYCLOAK_NS) KEYCLOAK_CHART=$(KEYCLOAK_CHART) KEYCLOAK_REALM=$(KEYCLOAK_REALM) KEYCLOAK_NAME=$(KEYCLOAK_NAME)

keycloak-add-users: ## Create missing Keycloak users and store passwords in a Secret (USERS_FILE=...)
	@$(SCRIPTS_DIR)/keycloak-users.sh add-users "$(USERS_FILE)"

keycloak-password: ## Show the Secret location for one user (KC_USER=alice)
	@if [ -z "$(KC_USER)" ]; then echo "Error: KC_USER is required. Pass KC_USER=alice." >&2; exit 1; fi
	@$(SCRIPTS_DIR)/keycloak-users.sh password "$(KC_USER)"

keycloak-reset-password: ## Reset one user's password in a Secret (KC_USER=alice)
	@if [ -z "$(KC_USER)" ]; then echo "Error: KC_USER is required. Pass KC_USER=alice." >&2; exit 1; fi
	@$(SCRIPTS_DIR)/keycloak-users.sh reset-password "$(KC_USER)"

# Web UI sign-in: each workspace's web UIs (the VM dashboard, each sandbox
# UI route) need their redirect URI on Keycloak's dashboard client. The
# redirect registrar (charts/openshell-keycloak, on by default) registers
# them; with it off, run keycloak-register once the workspace exists (it waits
# up to REDIRECT_WAIT seconds for its routes) and keycloak-redirects-sync after
# deleting workspaces. See README, "Web UI sign-in".
REDIRECT_WAIT ?= 600
KC_REDIRECTS_ENV = KEYCLOAK_NS=$(KEYCLOAK_NS) KEYCLOAK_REALM=$(KEYCLOAK_REALM) KEYCLOAK_NAME=$(KEYCLOAK_NAME) WAIT=$(REDIRECT_WAIT)

keycloak-register: ## Register a user's Keycloak account and web UI redirects (KC_USER=alice)
	@if [ -z "$(KC_USER)" ]; then echo "Error: KC_USER is required. Pass KC_USER=alice." >&2; exit 1; fi
	@printf 'users:\n  - name: %s\n' "$(KC_USER)" | $(KC_USERS_ENV) $(SCRIPTS_DIR)/keycloak-users.sh add-users -
	@$(KC_REDIRECTS_ENV) uv run --locked $(SCRIPTS_DIR)/keycloak-redirects.py register "$(KC_USER)"

keycloak-redirects: ## List the dashboard client's redirect URIs, and the web UI routes that have none yet
	@$(KC_REDIRECTS_ENV) uv run --locked $(SCRIPTS_DIR)/keycloak-redirects.py list

keycloak-redirects-sync: ## Register every workspace's web UI redirect URIs, and remove those of deleted workspaces
	@$(KC_REDIRECTS_ENV) uv run --locked $(SCRIPTS_DIR)/keycloak-redirects.py sync

keycloak-check: ## Check the Keycloak in KEYCLOAK_NS is configured for OpenShell (realm, CLI client, roles)
	@$(SCRIPTS_DIR)/keycloak-check.sh

keycloak-issuer: ## Print the Keycloak OIDC issuer URL
	@host=$$($(SCRIPTS_DIR)/keycloak-host.sh "$(KEYCLOAK_NS)") || exit 1; \
		echo "https://$${host}/realms/$(KEYCLOAK_REALM)"

login: ## Authenticate with the OIDC provider
	@NS="$(KEYCLOAK_NS)" \
	$(SCRIPTS_DIR)/oidc-login.sh login

whoami: ## Show current OIDC identity and token status
	@$(SCRIPTS_DIR)/oidc-login.sh whoami

logout: ## Revoke OIDC token and clear sandbox credentials
	@rc=0; $(SCRIPTS_DIR)/oidc-login.sh logout || rc=$$?; \
		$(SCRIPTS_DIR)/openshell-saw-logout.sh || { gateway_rc=$$?; \
			if [ $$rc -eq 0 ]; then rc=$$gateway_rc; fi; }; \
		if [ $$rc -ne 0 ]; then \
			echo "Error: logout could not confirm all remote revocations or local cleanup." >&2; \
		fi; exit $$rc

keycloak-delete: ## Uninstall Keycloak and its database
	@$(SCRIPTS_DIR)/keycloak-delete.sh

