# Shared namespace: golden image, image builds, governance interceptor.
NS             ?= openshell-agents
BUILD_NS       ?= openshell-agents
QUAY_REPO      ?= quay.io/rh-ai-quickstart
# Images `make copy-images` mirrors into the internal registry. Only the
# gateway VM disk (golden image) is needed; the VM pulls sandbox and
# NemoClaw CLI images from quay itself.
MIRROR_IMAGES  ?= openshell-gateway
OPENSHELL_VERSION ?= 0.0.116
# OpenShell release the governance interceptor is built from (must match the
# SAW gateways; image-builder-charts/helm/governance-interceptor-image).
OPENSHELL_INTERCEPTOR_REF ?= v0.1.2
OPENSHELL_SAW_NAME ?=
SANDBOX_IMAGE  ?=
AGENT          ?= openclaw
CONTAINER_RUNTIME ?= podman
IMAGE_NAME      = $(if $(filter docker,$(CONTAINER_RUNTIME)),openshell-gateway-docker,openshell-gateway)
GOVERNANCE_ENABLED ?= true
PROVIDER       ?=
MODEL          ?=
API_KEY        ?=
ENDPOINT_URL   ?=
# Comma-separated SAW-BOM profiles for openshell-saw-create (default: data-science)
PROFILES       ?=
WEB_SEARCH     ?=
GCP_SA_JSON    ?=
OIDC_ISSUER    ?=
OIDC_CLIENT_ID ?= openshell-cli
OIDC_FLOW      ?= browser
OIDC_TOKEN_DIR ?= $(HOME)/.config/openshell/oidc
SSH_KEY_PATH   ?= $(HOME)/.generated-ssh-keys/sandbox-ssh
OWNER          ?=
# Each SAW (user workspace) gets its own namespace.
SAW_NS         ?= saw-$(OPENSHELL_SAW_NAME)
HELM_DIR       := image-builder-charts/helm/
SAW_CHART  := charts/openshell-saw
KEYCLOAK_CHART := charts/openshell-keycloak
# Keycloak (and the RHBK operator) can live in any namespace.
KEYCLOAK_NS    ?= saw-keycloak
KEYCLOAK_REALM ?= openshell
# yes/no: let `make keycloak` import the realm into a Keycloak already in KEYCLOAK_NS
USE_EXISTING_KEYCLOAK ?=
SCRIPTS_DIR    := scripts
GUI_PORT       ?= 18789
WORKSPACE      ?= default


.check-saw-name:
	@if [ -z "$(OPENSHELL_SAW_NAME)" ]; then \
		echo "Error: OPENSHELL_SAW_NAME is required."; \
		echo "  Set it via: export OPENSHELL_SAW_NAME=my-saw"; \
		echo "  Or pass it: make <target> OPENSHELL_SAW_NAME=my-saw"; \
		exit 1; \
	fi

.check-ssh-key:
	@test -f "$(SSH_KEY_PATH).pub" || { \
		echo "Error: SSH key not found at $(SSH_KEY_PATH).pub"; \
		echo "Generate one with: make generate-keys"; \
		echo "Or set SSH_KEY_PATH to your own key: make openshell-saw-create SSH_KEY_PATH=~/.ssh/my_key"; \
		exit 1; \
	}

.check-gateway-ca:
	@test -f "$(HOME)/.config/openshell/gateways/$(OPENSHELL_SAW_NAME)/mtls/ca.crt" || { \
		echo "Error: Gateway CA certificate not found for '$(OPENSHELL_SAW_NAME)'."; \
		echo "Run 'make openshell-saw-configure-gateway OPENSHELL_SAW_NAME=$(OPENSHELL_SAW_NAME)' first."; \
		exit 1; \
	}

.check-prereqs:
	@echo "Checking prerequisites..."
	@command -v oc >/dev/null 2>&1 || { echo "Error: 'oc' CLI not found."; exit 1; }
	@command -v helm >/dev/null 2>&1 || { echo "Error: 'helm' CLI not found."; exit 1; }
	@command -v virtctl >/dev/null 2>&1 || echo "Warning: 'virtctl' not found. Install it for SSH access to sandbox VMs."
	@command -v openshell >/dev/null 2>&1 || echo "Warning: 'openshell' CLI not found. Install from https://github.com/NVIDIA/OpenShell/releases"
	@oc whoami >/dev/null 2>&1 || { echo "Error: Not logged in to OpenShift."; exit 1; }
	@echo "  oc:        $$(oc version --client -o json 2>/dev/null | jq -r '.releaseClientVersion // .clientVersion.gitVersion // "ok"')"
	@echo "  helm:      $$(helm version --short 2>/dev/null)"
	@command -v virtctl >/dev/null 2>&1 && echo "  virtctl:   $$(virtctl version --client 2>/dev/null | head -1)" || true
	@command -v openshell >/dev/null 2>&1 && echo "  openshell: $$(openshell --version 2>/dev/null)" || true
	@command -v openssl >/dev/null 2>&1 && echo "  openssl:   $$(openssl version 2>/dev/null)" || \
		{ echo "Error: openssl is required (used by 'make login' for PKCE challenge generation)."; exit 1; }
	@echo "Checking operators..."
	@oc get csv -n openshift-cnv 2>/dev/null | grep -q kubevirt || { echo "Error: OpenShift Virtualization not installed."; exit 1; }
	@echo "  OpenShift Virtualization: installed"
	@if oc get csv -n $(KEYCLOAK_NS) 2>/dev/null | grep -q rhbk; then \
		echo "  RHBK (Keycloak): installed in $(KEYCLOAK_NS)"; \
	elif oc get csv --all-namespaces 2>/dev/null | grep -q rhbk; then \
		RHBK_NS=$$(oc get csv --all-namespaces 2>/dev/null | grep rhbk | awk '{print $$1}' | head -1); \
		echo "Error: RHBK operator found in namespace '$${RHBK_NS}', but KEYCLOAK_NS is '$(KEYCLOAK_NS)'."; \
		echo "  Either use the Keycloak there:    KEYCLOAK_NS=$${RHBK_NS}"; \
		echo "  or install RHBK in '$(KEYCLOAK_NS)' as well (OperatorHub, 'A specific namespace')."; \
		exit 1; \
	else \
		echo "Error: RHBK operator not installed. Install it in '$(KEYCLOAK_NS)':"; \
		echo "    oc create namespace $(KEYCLOAK_NS) --dry-run=client -o yaml | oc apply -f -"; \
		echo "    oc apply -f - <<EOF"; \
		echo "apiVersion: operators.coreos.com/v1"; \
		echo "kind: OperatorGroup"; \
		echo "metadata:"; \
		echo "  name: $(KEYCLOAK_NS)-og"; \
		echo "  namespace: $(KEYCLOAK_NS)"; \
		echo "spec:"; \
		echo "  targetNamespaces:"; \
		echo "    - $(KEYCLOAK_NS)"; \
		echo "---"; \
		echo "apiVersion: operators.coreos.com/v1alpha1"; \
		echo "kind: Subscription"; \
		echo "metadata:"; \
		echo "  name: rhbk-operator"; \
		echo "  namespace: $(KEYCLOAK_NS)"; \
		echo "spec:"; \
		echo "  channel: stable-v26"; \
		echo "  name: rhbk-operator"; \
		echo "  source: redhat-operators"; \
		echo "  sourceNamespace: openshift-marketplace"; \
		echo "EOF"; \
		exit 1; \
	fi
	@if [ -f "$(SSH_KEY_PATH).pub" ]; then echo "  SSH key: $(SSH_KEY_PATH)"; \
	else echo "  SSH key: not found. Run 'make generate-keys'."; fi
	@echo "Checking image registry route..."
	@if ! oc get route default-route -n openshift-image-registry >/dev/null 2>&1; then \
		echo "  Image registry route: enabling..."; \
		oc patch configs.imageregistry.operator.openshift.io/cluster --patch '{"spec":{"defaultRoute":true}}' --type=merge >/dev/null 2>&1; \
	fi; \
	echo "  Image registry route: enabled"
	@echo "Prerequisites OK."

.PHONY: check-prereqs keycloak-check generate-keys \
        build-nemoclaw build-nemoclaw-cli build-openclaw-openshell build-openclaw-openshell-local \
        build-gateway-docker build-gateway-podman copy-images \
        keycloak keycloak-issuer login whoami logout delete-keycloak \
        openshell-saw-create openshell-saw-list openshell-saw-logs openshell-saw-status openshell-saw-restart openshell-saw-vm-ssh openshell-saw-ssh ssh-secret \
        openshell-saw-configure-gateway openshell-saw-tui openshell-saw-gui test \
        openshell-saw-delete sandbox-pre-delete delete-all status \
        governance-list-profiles governance-add-profile governance-remove-profile governance-create-profile governance-demo \
        .check-saw-name .check-ssh-key .check-gateway-ca .check-prereqs

check-prereqs: .check-prereqs ## Verify required operators and CLI tools

generate-keys: ## Generate SSH keypair for sandbox provisioning
	@$(SCRIPTS_DIR)/generate-keys.sh

# --- NemoClaw images ---

build-nemoclaw: ## Build NemoClaw sandbox image and push to quay (set OTEL=1 to include diagnostics-otel)
	-@oc delete is nemoclaw-sandbox -n $(BUILD_NS) 2>/dev/null
	helm upgrade --install nemoclaw-imagestream $(HELM_DIR)nemoclaw-imagestream \
		--namespace $(BUILD_NS) --create-namespace \
		$(if $(filter 1,$(OTEL)),--set build.otelEnabled=1)
	oc start-build nemoclaw-sandbox -n $(BUILD_NS) --follow
	@echo "Pushing nemoclaw-sandbox to $(QUAY_REPO)..."
	@$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) nemoclaw-sandbox $(QUAY_REPO) $(OPENSHELL_VERSION)

build-nemoclaw-cli: ## Build NemoClaw CLI image and push to quay
	-@oc delete is nemoclaw-cli -n $(BUILD_NS) 2>/dev/null
	helm upgrade --install nemoclaw-cli-imagestream $(HELM_DIR)nemoclaw-cli-imagestream \
		--namespace $(BUILD_NS) --create-namespace
	oc start-build nemoclaw-cli -n $(BUILD_NS) --follow
	@echo "Pushing nemoclaw-cli to $(QUAY_REPO)..."
	@$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) nemoclaw-cli $(QUAY_REPO) $(OPENSHELL_VERSION)

build-openclaw-openshell: build-openclaw-openshell-local ## Build the openclaw-openshell sandbox image and push to quay
	@echo "Pushing openclaw-openshell to $(QUAY_REPO)..."
	@$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) openclaw-openshell $(QUAY_REPO) $(OPENSHELL_VERSION)

build-openclaw-openshell-local: ## Build the openclaw-openshell sandbox image into this cluster's internal registry only (no quay push access needed)
	-@oc delete is openclaw-openshell -n $(BUILD_NS) 2>/dev/null
	helm upgrade --install openclaw-openshell-image $(HELM_DIR)openclaw-openshell-image \
		--namespace $(BUILD_NS) --create-namespace
	oc start-build openclaw-openshell -n $(BUILD_NS) --follow
	@echo "Built into image-registry.openshift-image-registry.svc.cluster.local:5000/$(BUILD_NS)/openclaw-openshell:latest"
	@echo "Point a BOM profile's sandbox image at that path and enable internalRegistry.allowAnonymousPull"
	@echo "(see charts/openshell-saw/values.yaml) if you don't have quay push access."

# --- Governance interceptor image ---

build-governance-interceptor: ## Build governance interceptor image on cluster and push it to quay (needs quay-push-secret)
	-@oc delete is governance-interceptor -n $(BUILD_NS) 2>/dev/null
	helm upgrade --install governance-interceptor-image $(HELM_DIR)governance-interceptor-image \
		--namespace $(BUILD_NS) --create-namespace
	oc start-build governance-interceptor -n $(BUILD_NS) --follow
	@echo "The build pushed $$(helm get values governance-interceptor-image -n $(BUILD_NS) -a -o json | jq -r .output.externalImage)"

build-governance-interceptor-local: ## Build governance interceptor image into this cluster's internal registry only
	helm upgrade --install governance-interceptor-image $(HELM_DIR)governance-interceptor-image \
		--namespace $(BUILD_NS) --create-namespace \
		--set source.git.ref=$(OPENSHELL_INTERCEPTOR_REF) \
		--set output.imageStreamTag=governance-interceptor:v$(patsubst v%,%,$(OPENSHELL_INTERCEPTOR_REF))
	oc start-build governance-interceptor -n $(BUILD_NS) --follow

# --- Gateway VM image ---

build-gateway-docker: ## Build Docker gateway VM image and push to quay
	@echo "Building Docker gateway image (openshell-gateway-docker)..."
	-@oc delete dv openshell-gateway-docker-golden -n $(BUILD_NS) 2>/dev/null
	-@oc delete datasource openshell-gateway-docker -n $(BUILD_NS) 2>/dev/null
	-@oc delete pvc openshell-gateway-docker-golden -n $(BUILD_NS) 2>/dev/null
	-@oc delete builds -l buildconfig=openshell-gateway-docker -n $(BUILD_NS) 2>/dev/null
	-@oc delete is openshell-gateway-docker -n $(BUILD_NS) 2>/dev/null
	@GOLDEN_FLAG=""; \
	if ! oc api-resources --api-group=cdi.kubevirt.io 2>/dev/null | grep datavolumes >/dev/null 2>&1; then \
		GOLDEN_FLAG="--set goldenImage.enabled=false"; \
	fi; \
	helm upgrade --install openshell-gateway-docker-image $(HELM_DIR)openshell-gateway-image \
		--namespace $(BUILD_NS) --create-namespace $$GOLDEN_FLAG \
		--set containerRuntime=docker
	oc start-build openshell-gateway-docker -n $(BUILD_NS) --follow
	@echo "Pushing openshell-gateway-docker to $(QUAY_REPO)..."
	@$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) openshell-gateway-docker $(QUAY_REPO) $(OPENSHELL_VERSION)

build-gateway-podman: ## Build Podman gateway VM image and push to quay
	@echo "Building Podman gateway image (openshell-gateway)..."
	-@oc delete dv openshell-gateway-golden -n $(BUILD_NS) 2>/dev/null
	-@oc delete datasource openshell-gateway -n $(BUILD_NS) 2>/dev/null
	-@oc delete pvc openshell-gateway-golden -n $(BUILD_NS) 2>/dev/null
	-@oc delete builds -l buildconfig=openshell-gateway -n $(BUILD_NS) 2>/dev/null
	-@oc delete is openshell-gateway -n $(BUILD_NS) 2>/dev/null
	@GOLDEN_FLAG=""; \
	if ! oc api-resources --api-group=cdi.kubevirt.io 2>/dev/null | grep datavolumes >/dev/null 2>&1; then \
		GOLDEN_FLAG="--set goldenImage.enabled=false"; \
	fi; \
	helm upgrade --install openshell-gateway-image $(HELM_DIR)openshell-gateway-image \
		--namespace $(BUILD_NS) --create-namespace $$GOLDEN_FLAG \
		--set containerRuntime=podman
	oc start-build openshell-gateway -n $(BUILD_NS) --follow
	@echo "Pushing openshell-gateway to $(QUAY_REPO)..."
	@$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) openshell-gateway $(QUAY_REPO) $(OPENSHELL_VERSION)


copy-images: ## Mirror pre-built images from quay to the internal registry
	@echo "Ensuring namespace and image registry route..."
	@oc create namespace $(BUILD_NS) --dry-run=client -o yaml | oc apply -f - 2>/dev/null
	@oc patch configs.imageregistry.operator.openshift.io/cluster \
		--patch '{"spec":{"defaultRoute":true}}' --type=merge >/dev/null 2>&1 || true
	@if [ "$$(uname -s)" = "Darwin" ]; then \
		echo "macOS detected — using in-cluster skopeo Jobs (avoids podman-machine upload drops)."; \
		BUILD_NS=$(BUILD_NS) QUAY_REPO=$(QUAY_REPO) OPENSHELL_VERSION=$(OPENSHELL_VERSION) IMAGES="$(MIRROR_IMAGES)" \
			$(SCRIPTS_DIR)/mirror-images-incluster.sh; \
	else \
		for i in $$(seq 1 30); do \
			REGISTRY=$$(oc get route default-route -n openshift-image-registry -o jsonpath='{.spec.host}' 2>/dev/null); \
			if [ -n "$$REGISTRY" ]; then break; fi; \
			sleep 5; \
		done; \
		echo "Authenticating to internal registry..."; \
		REGISTRY=$$(oc get route default-route -n openshift-image-registry -o jsonpath='{.spec.host}' 2>/dev/null); \
		TOKEN=$$(oc whoami -t); \
		podman login --tls-verify=false -u unused -p $${TOKEN} $${REGISTRY} >/dev/null 2>&1 || \
		docker login $${REGISTRY} -u unused -p $${TOKEN} >/dev/null 2>&1 || echo "WARN: Container runtime login failed — oc image mirror will use oc credentials"; \
		echo "Mirroring images from $(QUAY_REPO) to internal registry..."; \
		REGISTRY=$$(oc get route default-route -n openshift-image-registry -o jsonpath='{.spec.host}' 2>/dev/null); \
		if [ -z "$$REGISTRY" ]; then echo "Error: Image registry route not available after waiting."; exit 1; fi; \
		for image in $(MIRROR_IMAGES); do \
			done_tag=""; \
			for tag in $(OPENSHELL_VERSION) v$(OPENSHELL_VERSION:v%=%) latest; do \
				echo "  Mirroring $${image}:$${tag}..."; \
				if oc image mirror $(QUAY_REPO)/$${image}:$${tag} $${REGISTRY}/$(BUILD_NS)/$${image}:$(OPENSHELL_VERSION) --insecure=true >/tmp/mirror.$$$$ 2>&1; then \
					done_tag=$${tag}; break; \
				fi; \
				tail -1 /tmp/mirror.$$$$; \
			done; rm -f /tmp/mirror.$$$$; \
			if [ -z "$$done_tag" ]; then echo "Error: $${image} not found on $(QUAY_REPO)"; exit 1; fi; \
			oc tag $(BUILD_NS)/$${image}:$(OPENSHELL_VERSION) $(BUILD_NS)/$${image}:latest 2>/dev/null || true; \
			echo "  $${image} done ($${done_tag})."; \
		done; \
		echo "All images mirrored (tag: $(OPENSHELL_VERSION), also tagged as :latest)."; \
	fi

# Clean stale operator CRDs from a previous install that block reinstallation.
# CNV leaves CRDs with broken conversion webhooks; RHBK CSV races the OperatorGroup.
# Safe to run on a clean cluster (no-ops if nothing stale exists).
clean-stale-operators:
	@echo "Cleaning stale operator CRDs (if any)..."
	@for crd in $$(oc get crd 2>/dev/null | grep -E 'kubevirt|hco|cdi|aaq|hpp|ssp|cnao' | awk '{print $$1}'); do \
		oc patch crd "$$crd" --type json -p '[{"op":"replace","path":"/spec/conversion","value":{"strategy":"None"}}]' 2>/dev/null || true; \
		oc delete crd "$$crd" 2>/dev/null || true; \
	done
	@for app in $$(oc get application -n vp-gitops -o name 2>/dev/null); do \
		oc patch $$app -n vp-gitops --type json -p '[{"op":"remove","path":"/metadata/finalizers"}]' 2>/dev/null || true; \
	done
	@echo "Stale operator cleanup done."

# Delete VMs, HyperConverged CR, and operator CRDs before uninstall so
# ArgoCD doesn't get stuck on webhook finalizers. OLM cleanup (Subscription/
# CSV/InstallPlan) is intentionally deferred to the uninstall target below,
# after the Ansible framework removes ArgoCD apps — otherwise ArgoCD
# immediately recreates the Subscription we just deleted.
pre-uninstall:
	@echo "Pre-uninstall: deleting VMs and CNV resources..."
	oc delete vm,dv,job --all -n $(NS) --wait=false --ignore-not-found=true
	@echo "Waiting for VMIs to terminate..."
	oc wait --for=delete vmi --all -n $(NS) --timeout=120s
	oc delete hyperconverged --all -n openshift-cnv --wait=false --ignore-not-found=true
	$(MAKE) clean-stale-operators

# Generate SSH keys before install. No deletions — safe to run repeatedly.
pattern-install: generate-keys

# Override Makefile-common's uninstall to handle missing pattern CR gracefully.
# OLM cleanup runs AFTER rhvp.cluster_utils.uninstall removes the ArgoCD apps
# (including the openshift-cnv app that manages the Subscription). This prevents
# ArgoCD from fighting the cleanup by immediately recreating deleted resources.
uninstall: pre-uninstall ## Uninstall the pattern (with pre-cleanup)
	@if oc get patterns secure-agent-workspace -n patterns-operator >/dev/null 2>&1; then \
		$(ANSIBLE_RUN) rhvp.cluster_utils.uninstall; \
	else \
		echo "Pattern CR not found — already uninstalled. Cleaning up namespace..."; \
		oc delete ns $(NS) --wait=false --ignore-not-found=true; \
	fi
	@echo "Cleaning OLM state for openshift-cnv to prevent stale InstallPlan on reinstall..."
	oc delete subscription,csv,installplan --all -n openshift-cnv --wait=false --ignore-not-found=true

# Clean up a single sandbox's heavy resources before uninstall to prevent
# finalizer hangs. VMs and DataVolumes take time to terminate and block
# ArgoCD app deletion. Scoped to OPENSHELL_SAW_NAME only — NOT named
# "uninstall"/"pre-uninstall", since those names collide with the
# pre-existing `uninstall` target in Makefile-common (the one
# `./pattern.sh make uninstall` calls). Make merges prerequisite lists
# across repeated target definitions, so reusing that name here would
# silently attach this namespace-wide cleanup to every future call of the
# framework's own uninstall target, deleting every sandbox VM/DataVolume in
# a shared namespace instead of just this one.
sandbox-pre-delete: .check-saw-name
	@echo "Cleaning up heavy resources for '$(OPENSHELL_SAW_NAME)' before uninstall..."
	-@oc delete vm $(OPENSHELL_SAW_NAME) -n $(SAW_NS) --wait=false 2>/dev/null
	-@oc delete dv $(OPENSHELL_SAW_NAME)-root -n $(SAW_NS) --wait=false 2>/dev/null
	-@oc delete job $(OPENSHELL_SAW_NAME)-prepare -n $(SAW_NS) --wait=false 2>/dev/null
	@echo "Heavy resources for '$(OPENSHELL_SAW_NAME)' scheduled for deletion."

# --- Keycloak / OIDC ---

keycloak: ## Deploy Keycloak + realm (uses a Keycloak already in KEYCLOAK_NS if configured; asks before importing the realm into it)
	@KEYCLOAK_NS=$(KEYCLOAK_NS) KEYCLOAK_CHART=$(KEYCLOAK_CHART) KEYCLOAK_REALM=$(KEYCLOAK_REALM) \
	USE_EXISTING_KEYCLOAK=$(USE_EXISTING_KEYCLOAK) $(SCRIPTS_DIR)/deploy-keycloak.sh

keycloak-check: ## Check the Keycloak in KEYCLOAK_NS is configured for OpenShell (realm, CLI client, roles)
	@KEYCLOAK_NS=$(KEYCLOAK_NS) KEYCLOAK_REALM=$(KEYCLOAK_REALM) OIDC_CLIENT_ID=$(OIDC_CLIENT_ID) \
	$(SCRIPTS_DIR)/keycloak-check.sh

keycloak-issuer: ## Print the Keycloak OIDC issuer URL
	@host=$$($(SCRIPTS_DIR)/keycloak-host.sh $(KEYCLOAK_NS)) || exit 1; \
	echo "https://$${host}/realms/$(KEYCLOAK_REALM)"

login: ## Authenticate with the OIDC provider
	@OIDC_ISSUER=$(OIDC_ISSUER) OIDC_CLIENT_ID=$(OIDC_CLIENT_ID) \
	OIDC_FLOW=$(OIDC_FLOW) OIDC_TOKEN_DIR=$(OIDC_TOKEN_DIR) NS=$(KEYCLOAK_NS) KEYCLOAK_REALM=$(KEYCLOAK_REALM) \
	$(SCRIPTS_DIR)/oidc-login.sh login

whoami: ## Show current OIDC identity and token status
	@OIDC_TOKEN_DIR=$(OIDC_TOKEN_DIR) $(SCRIPTS_DIR)/oidc-login.sh whoami

logout: ## Revoke OIDC token and clear sandbox credentials
	@OIDC_CLIENT_ID=$(OIDC_CLIENT_ID) OIDC_TOKEN_DIR=$(OIDC_TOKEN_DIR) \
	$(SCRIPTS_DIR)/oidc-login.sh logout
	@NS=$(NS) SSH_KEY_PATH=$(SSH_KEY_PATH) $(SCRIPTS_DIR)/openshell-saw-logout.sh

delete-keycloak: ## Uninstall Keycloak + PostgreSQL
	-helm uninstall openshell-keycloak --namespace $(KEYCLOAK_NS) 2>/dev/null
	-oc delete pvc keycloak-db -n $(KEYCLOAK_NS) 2>/dev/null
	-oc delete secret keycloak-db-secret -n $(KEYCLOAK_NS) 2>/dev/null
	@echo "Keycloak cleaned up."

# --- SSH secret ---

ssh-secret: ## (Legacy) SSH key secrets in $(NS); provisioning no longer uses them
	oc -n $(NS) create secret generic openshell-aap-ssh \
		--from-file=key=$(SSH_KEY_PATH) \
		--dry-run=client -o yaml | oc apply -f -
	oc -n $(NS) create secret generic openshell-ssh-pubkey \
		--from-file=key=$(SSH_KEY_PATH).pub \
		--dry-run=client -o yaml | oc apply -f -

# --- Sandbox ---

openshell-saw-create: .check-saw-name ## Provision a sandbox (PROVIDER=, MODEL=, API_KEY=, CONTAINER_RUNTIME=podman|docker)
	@NS=$(NS) SAW_NS=$(SAW_NS) KEYCLOAK_NS=$(KEYCLOAK_NS) KEYCLOAK_REALM=$(KEYCLOAK_REALM) \
	OPENSHELL_SAW_NAME=$(OPENSHELL_SAW_NAME) SAW_CHART=$(SAW_CHART) \
	SANDBOX_IMAGE=$(SANDBOX_IMAGE) AGENT=$(AGENT) \
	PROVIDER=$(PROVIDER) MODEL=$(MODEL) API_KEY=$(API_KEY) \
	ENDPOINT_URL=$(ENDPOINT_URL) PROFILES=$(PROFILES) WEB_SEARCH=$(WEB_SEARCH) GCP_SA_JSON=$(GCP_SA_JSON) \
	OIDC_ISSUER=$(OIDC_ISSUER) OIDC_CLIENT_ID=$(OIDC_CLIENT_ID) \
	OIDC_TOKEN_DIR=$(OIDC_TOKEN_DIR) OWNER=$(OWNER) \
	SCRIPTS_DIR=$(SCRIPTS_DIR) \
	CONTAINER_RUNTIME=$(CONTAINER_RUNTIME) \
	GOVERNANCE_ENABLED=$(GOVERNANCE_ENABLED) \
	$(SCRIPTS_DIR)/openshell-saw-create.sh

openshell-saw-configure-gateway: .check-saw-name ## Configure openshell CLI for a sandbox gateway
	@command -v openshell >/dev/null 2>&1 || { echo "Error: openshell CLI not found."; exit 1; }
	@GW_URL=$$(oc get route $(OPENSHELL_SAW_NAME)-gateway -n $(SAW_NS) -o jsonpath='https://{.spec.host}' 2>/dev/null); \
	if [ -z "$$GW_URL" ]; then echo "Error: Gateway route not found for '$(OPENSHELL_SAW_NAME)'."; exit 1; fi; \
	OIDC_ISSUER="$(OIDC_ISSUER)"; \
	if [ -z "$$OIDC_ISSUER" ]; then \
		KC_HOST=$$($(SCRIPTS_DIR)/keycloak-host.sh $(KEYCLOAK_NS) 2>/dev/null); \
		if [ -n "$$KC_HOST" ]; then OIDC_ISSUER="https://$$KC_HOST/realms/$(KEYCLOAK_REALM)"; fi; \
	fi; \
	OIDC_OPTS=""; \
	if [ -n "$$OIDC_ISSUER" ]; then OIDC_OPTS="--oidc-issuer $$OIDC_ISSUER --oidc-client-id $(OIDC_CLIENT_ID)"; fi; \
	GW_CONFIG_DIR="$$HOME/.config/openshell/gateways/$(OPENSHELL_SAW_NAME)"; \
	NS=$(SAW_NS) VM_NAME=$(OPENSHELL_SAW_NAME) SSH_KEY_PATH=$(SSH_KEY_PATH) \
	OUT_FILE="$$GW_CONFIG_DIR/mtls/ca.crt" \
	$(SCRIPTS_DIR)/extract-gateway-ca.sh || exit 1; \
	echo "Registering gateway '$(OPENSHELL_SAW_NAME)'..."; \
	openshell gateway remove $(OPENSHELL_SAW_NAME) 2>/dev/null || true; \
	openshell gateway add "$$GW_URL" --name $(OPENSHELL_SAW_NAME) $$OIDC_OPTS || exit 1; \
	openshell gateway select $(OPENSHELL_SAW_NAME) || exit 1; \
	echo "Gateway '$(OPENSHELL_SAW_NAME)' configured. Endpoint: $$GW_URL"
# Keep the token saved by `openshell gateway add`. The separate make-login token
# may belong to another cluster and must not overwrite this gateway's login.

openshell-saw-list: ## List all sandboxes (every SAW namespace)
	@printf "%-20s %-24s %-12s %-10s %s\n" "NAME" "NAMESPACE" "STATUS" "VM" "UPDATED"
	@helm list -A -o json 2>/dev/null \
		| jq -r '.[] | select(.chart | startswith("openshell-saw")) | "\(.name) \(.namespace) \(.status) \(.updated | split(".")[0])"' 2>/dev/null \
		| while read -r name ns status updated; do \
			vm=$$(kubectl get vm "$$name" -n "$$ns" -o jsonpath='{.status.printableStatus}' 2>/dev/null || echo "n/a"); \
			printf "%-20s %-24s %-12s %-10s %s\n" "$$name" "$$ns" "$$status" "$${vm:-n/a}" "$$updated"; \
		done

openshell-saw-logs: .check-saw-name ## Follow the in-VM installer (serial console)
	oc -n $(SAW_NS) logs -f -l vm.kubevirt.io/name=$(OPENSHELL_SAW_NAME) -c guest-console-log --tail=-1

openshell-saw-status: .check-saw-name .check-ssh-key ## Show the in-VM installer status (over vm-ssh)
	@SAW_NS=$(SAW_NS) VM_NAME=$(OPENSHELL_SAW_NAME) SSH_KEY_PATH=$(SSH_KEY_PATH) \
	$(SCRIPTS_DIR)/openshell-saw-vm-ssh.sh 'sudo cat /var/lib/saw/status.json'

openshell-saw-vm-ssh: .check-saw-name .check-ssh-key ## Shell on the gateway VM: adds your key to its accessCredentials Secret (CMD= to run one command)
	@SAW_NS=$(SAW_NS) VM_NAME=$(OPENSHELL_SAW_NAME) SSH_KEY_PATH=$(SSH_KEY_PATH) \
	$(SCRIPTS_DIR)/openshell-saw-vm-ssh.sh

# --- Harness bundles (skills, MCP servers, OpenClaw tool plugins) ---
# harness-bundles/<bundle>/ as an OCI image, mounted read-only at
# /sandbox/harness. HARNESS_BUNDLE=ds-default HARNESS_REPO=ghcr.io/<owner>/saw-harness-ds-default

HARNESS_BUNDLE ?= ds-default

.PHONY: harness-bundle-build harness-bundle-push
harness-bundle-build: ## Build harness-bundles/$(HARNESS_BUNDLE) as a local OCI image
	@$(SCRIPTS_DIR)/harness-bundle.sh build $(HARNESS_BUNDLE)

harness-bundle-push: ## Push harness-bundles/$(HARNESS_BUNDLE) to $(HARNESS_REPO) and print the harnessRef
	@test -n "$(HARNESS_REPO)" || { echo "set HARNESS_REPO, e.g. ghcr.io/<owner>/saw-harness-$(HARNESS_BUNDLE)"; exit 1; }
	@$(SCRIPTS_DIR)/harness-bundle.sh push $(HARNESS_BUNDLE) $(HARNESS_REPO)

openshell-saw-restart: .check-saw-name ## Restart the VM so it applies a changed BOM/profile
	virtctl -n $(SAW_NS) restart $(OPENSHELL_SAW_NAME)

openshell-saw-ssh: .check-saw-name .check-gateway-ca ## SSH into a sandbox
	@ssh -o "ProxyCommand=openshell ssh-proxy --gateway-name $(OPENSHELL_SAW_NAME) --name $(OPENSHELL_SAW_NAME) " \
		-o StrictHostKeyChecking=no \
		-o UserKnownHostsFile=/dev/null \
		-o LogLevel=ERROR \
		sandbox@openshell-$(OPENSHELL_SAW_NAME).default

# --- User access ---

nemoclaw-tui: .check-saw-name .check-gateway-ca ## Launch NemoClaw TUI (e.g. make nemoclaw-tui SANDBOX_NAME=cuda-sandbox WORKSPACE=cuda-dev)
	@if [ -n "$(SANDBOX_NAME)" ]; then \
		SANDBOX="$(SANDBOX_NAME)"; \
	else \
		SANDBOX=$$(openshell --gateway $(OPENSHELL_SAW_NAME) sandbox list --workspace $(WORKSPACE) --names 2>/dev/null | grep -E '^[a-zA-Z0-9_-]+$$' | head -1); \
	fi; \
	if [ -z "$$SANDBOX" ]; then echo "Error: No sandboxes found on gateway '$(OPENSHELL_SAW_NAME)' workspace '$(WORKSPACE)'."; exit 1; fi; \
	echo "Connecting to sandbox '$$SANDBOX' workspace '$(WORKSPACE)' (nemoclaw)..."; \
	ssh -o "ProxyCommand=openshell ssh-proxy --gateway-name $(OPENSHELL_SAW_NAME) --name $$SANDBOX --workspace $(WORKSPACE) " \
		-o StrictHostKeyChecking=no \
		-o UserKnownHostsFile=/dev/null \
		-o LogLevel=ERROR \
		-tt sandbox@openshell-$$SANDBOX.$(WORKSPACE) openclaw

openclaw-tui: .check-saw-name .check-gateway-ca ## Launch OpenClaw TUI (e.g. make openclaw-tui SANDBOX_NAME=notebook)
	@if [ -n "$(SANDBOX_NAME)" ]; then \
		SANDBOX="$(SANDBOX_NAME)"; \
	else \
		SANDBOX=$$(openshell --gateway $(OPENSHELL_SAW_NAME) sandbox list --workspace $(WORKSPACE) --names 2>/dev/null | grep -E '^[a-zA-Z0-9_-]+$$' | head -1); \
	fi; \
	if [ -z "$$SANDBOX" ]; then echo "Error: No sandboxes found on gateway '$(OPENSHELL_SAW_NAME)' workspace '$(WORKSPACE)'."; exit 1; fi; \
	echo "Connecting to sandbox '$$SANDBOX' workspace '$(WORKSPACE)' (openclaw)..."; \
	openshell sandbox exec -n $$SANDBOX --workspace $(WORKSPACE) --tty -- \
		/bin/bash -ic 'export HOME=/sandbox OPENCLAW_HOME=/sandbox SQLITE_TMPDIR=/sandbox/.openclaw/state TMPDIR=/sandbox/.openclaw/state OPENCLAW_NIX_MODE=0 TERM=xterm-256color; exec openclaw tui'

openshell-saw-tui: .check-saw-name ## Launch TUI (alias for nemoclaw-tui)
	@$(MAKE) nemoclaw-tui OPENSHELL_SAW_NAME=$(OPENSHELL_SAW_NAME) SANDBOX_NAME=$(SANDBOX_NAME) WORKSPACE=$(WORKSPACE)

nemoclaw-gui: .check-saw-name .check-gateway-ca ## Open NemoClaw web UI (e.g. make nemoclaw-gui SANDBOX_NAME=cuda-sandbox WORKSPACE=cuda-dev)
	@if [ -n "$(SANDBOX_NAME)" ]; then \
		SANDBOX="$(SANDBOX_NAME)"; \
	else \
		SANDBOX=$$(openshell --gateway $(OPENSHELL_SAW_NAME) sandbox list --workspace $(WORKSPACE) --names 2>/dev/null | grep -E '^[a-zA-Z0-9_-]+$$' | head -1); \
	fi; \
	if [ -z "$$SANDBOX" ]; then echo "Error: No sandboxes found."; exit 1; fi; \
	SANDBOX_NAME=$$SANDBOX GATEWAY_NAME=$(OPENSHELL_SAW_NAME) \
	WORKSPACE=$(WORKSPACE) GUI_PORT=$(GUI_PORT) $(SCRIPTS_DIR)/openshell-saw-gui.sh

openclaw-gui: .check-saw-name .check-gateway-ca ## Open OpenClaw web UI (e.g. make openclaw-gui SANDBOX_NAME=notebook GUI_PORT=28789)
	@if [ -n "$(SANDBOX_NAME)" ]; then \
		SANDBOX="$(SANDBOX_NAME)"; \
	else \
		SANDBOX=$$(openshell --gateway $(OPENSHELL_SAW_NAME) sandbox list --workspace $(WORKSPACE) --names 2>/dev/null | grep -E '^[a-zA-Z0-9_-]+$$' | head -1); \
	fi; \
	if [ -z "$$SANDBOX" ]; then echo "Error: No sandboxes found."; exit 1; fi; \
	echo "Fetching openclaw gateway token..."; \
	TOKEN=$$(openshell sandbox exec -n $$SANDBOX --workspace $(WORKSPACE) --no-tty -- \
		sh -c 'OPENCLAW_HOME=/sandbox cat /sandbox/.openclaw/openclaw.json' 2>/dev/null \
		| python3 -c "import sys,json; c=json.load(sys.stdin); print(c.get('gateway',{}).get('auth',{}).get('token',''))" 2>/dev/null || true); \
	if [ -z "$$TOKEN" ]; then echo "Error: Could not extract token."; exit 1; fi; \
	GUI_PORT=$${GUI_PORT:-18789}; \
	pids=$$(lsof -ti :$$GUI_PORT 2>/dev/null || true); \
	[ -n "$$pids" ] && kill $$pids 2>/dev/null && sleep 1; \
	echo ""; \
	echo "OpenClaw UI: http://localhost:$$GUI_PORT/#token=$$TOKEN"; \
	echo "Press Ctrl-C to stop."; \
	echo ""; \
	ssh -o "ProxyCommand=openshell ssh-proxy --gateway-name $(OPENSHELL_SAW_NAME) --name $$SANDBOX" \
		-o StrictHostKeyChecking=no \
		-o UserKnownHostsFile=/dev/null \
		-o LogLevel=ERROR \
		-L "$$GUI_PORT:127.0.0.1:18789" \
		-N sandbox@openshell-$$SANDBOX.$(WORKSPACE)

openshell-saw-gui: .check-saw-name ## Open web UI (alias for nemoclaw-gui)
	@$(MAKE) nemoclaw-gui OPENSHELL_SAW_NAME=$(OPENSHELL_SAW_NAME) SANDBOX_NAME=$(SANDBOX_NAME) WORKSPACE=$(WORKSPACE) GUI_PORT=$(GUI_PORT)

# --- Governance profiles ---

PROFILE_NAME   ?=
PROFILE_FILE   ?=

governance-list-profiles: ## List governance provider profiles
	@NS=$(SAW_NS) SAW_NAME=$(OPENSHELL_SAW_NAME) $(SCRIPTS_DIR)/governance-profile.sh list

governance-add-profile: ## Enable an existing profile (PROFILE_NAME=github)
	@NS=$(SAW_NS) SAW_NAME=$(OPENSHELL_SAW_NAME) $(SCRIPTS_DIR)/governance-profile.sh add $(PROFILE_NAME)

governance-remove-profile: ## Disable a provider profile (PROFILE_NAME=github)
	@NS=$(SAW_NS) SAW_NAME=$(OPENSHELL_SAW_NAME) $(SCRIPTS_DIR)/governance-profile.sh remove $(PROFILE_NAME)

governance-create-profile: ## Create a new profile from YAML (PROFILE_NAME=jira PROFILE_FILE=jira.yaml)
	@NS=$(SAW_NS) SAW_NAME=$(OPENSHELL_SAW_NAME) $(SCRIPTS_DIR)/governance-profile.sh create $(PROFILE_NAME) $(PROFILE_FILE)

governance-demo: .check-saw-name ## Run governance interceptor demo
	@$(SCRIPTS_DIR)/demo-governance.sh $(OPENSHELL_SAW_NAME)

# --- Test ---

test: ## Run headless E2E test (auto-detects provider from ~/values-secret.yaml)
	@$(SCRIPTS_DIR)/e2e-test.sh

# --- Teardown ---

openshell-saw-delete: sandbox-pre-delete ## Uninstall a sandbox and its namespace
	helm uninstall $(OPENSHELL_SAW_NAME) --namespace $(SAW_NS)
	@if [ "$$(oc get namespace $(SAW_NS) -o jsonpath='{.metadata.labels.openshell\.pattern/saw}' 2>/dev/null)" = "true" ]; then \
		oc delete namespace $(SAW_NS) --wait=false; \
	else \
		echo "Namespace $(SAW_NS) is not a SAW namespace (label openshell.pattern/saw=true); keeping it."; \
	fi

delete-all: ## Uninstall everything (keycloak + imagestreams + gateway image)
	-helm uninstall openshell-keycloak --namespace $(KEYCLOAK_NS) 2>/dev/null
	-helm uninstall openshell-gateway-image --namespace $(NS) 2>/dev/null
	-helm uninstall nemoclaw-imagestream --namespace $(NS) 2>/dev/null
	-helm uninstall nemoclaw-cli-imagestream --namespace $(NS) 2>/dev/null
	@echo "Note: sandbox releases must be uninstalled individually."

# --- Status ---

status: ## Show status of all OpenShell resources (every SAW namespace + $(NS))
	@echo "=== SAW namespaces ===" && oc get ns -l openshell.pattern/saw=true 2>/dev/null || true
	@echo "" && echo "=== Helm releases ===" && helm list -A 2>/dev/null | awk 'NR==1 || /openshell-saw|saw-bom|governance-|openshell-keycloak/' || true
	@echo "" && echo "=== Gateway VMs ===" && oc get vm,vmi -A -l openshell.pattern/role=gateway 2>/dev/null || true
	@echo "" && echo "=== Prepare Jobs ===" && oc get jobs -A -l app.kubernetes.io/part-of=openshell-cnv-fedora 2>/dev/null || true
	@echo "" && echo "=== ImageStreams ($(NS)) ===" && oc -n $(NS) get is 2>/dev/null || true
	@echo "" && echo "=== Builds ($(NS)) ===" && oc -n $(NS) get builds 2>/dev/null || true

# --- In-guest installer tests (no cluster needed) ---
PYTHON ?= python3
.PHONY: test-installer
test-installer: ## Run installer + chart tests (chart tests need helm on PATH)
	@$(PYTHON) -c "import pytest, yaml, click, requests" 2>/dev/null || { \
		echo "Missing test dependencies for $(PYTHON). Install them with:"; \
		echo "  $(PYTHON) -m pip install -r tests/requirements.txt"; exit 1; }
	PYTHONPATH=cli/src$${PYTHONPATH:+:$$PYTHONPATH} $(PYTHON) -m pytest -q -p no:cacheprovider \
		tests/installer tests/charts tests/scripts cli/tests/test_kube.py cli/tests/test_cli.py
