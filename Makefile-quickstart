# --- NemoClaw images ---

sandbox-build: .check-image-repo ## Build audited discovery artifacts, then the sandbox (IMAGE_REPO opts into pushing)
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	@oc delete is nemoclaw-sandbox -n "$(BUILD_NS)" --ignore-not-found=true
	helm upgrade --install nemoclaw-imagestream $(HELM_DIR)nemoclaw-imagestream \
		--namespace $(BUILD_NS) --create-namespace --set-string source.discoveryImage=
	@set -eu; \
	discovery_build=$$(oc start-build nemoclaw-discovery-runtime -n "$(BUILD_NS)" -o name); \
	oc logs "$$discovery_build" -n "$(BUILD_NS)" --follow || true; \
	attempts=0; \
	while :; do \
		phase=$$(oc get "$$discovery_build" -n "$(BUILD_NS)" -o jsonpath='{.status.phase}'); \
		case "$$phase" in Complete|Failed|Cancelled|Error) break ;; esac; \
		if [ "$$attempts" -ge 360 ]; then echo "Error: timed out waiting for discovery build $$discovery_build ($$phase)." >&2; exit 1; fi; \
		attempts=$$((attempts + 1)); sleep 5; \
	done; \
	if [ "$$phase" != Complete ]; then echo "Error: discovery build $$discovery_build is $$phase, not Complete." >&2; exit 1; fi; \
	digest=$$(oc get "$$discovery_build" -n "$(BUILD_NS)" -o jsonpath='{.status.output.to.imageDigest}'); \
	if ! printf '%s\n' "$$digest" | grep -Eq '^sha256:[0-9a-f]{64}$$'; then \
		echo "Error: discovery build $$discovery_build has no valid output digest." >&2; exit 1; fi; \
	discovery_image="image-registry.openshift-image-registry.svc:5000/$(BUILD_NS)/nemoclaw-discovery-runtime@$$digest"; \
	helm upgrade --install nemoclaw-imagestream $(HELM_DIR)nemoclaw-imagestream \
		--namespace "$(BUILD_NS)" --set-string "source.discoveryImage=$$discovery_image" \
		$(if $(filter 1,$(OTEL)),--set build.otelEnabled=1)
	oc start-build nemoclaw-sandbox -n $(BUILD_NS) --follow --wait
	@if [ -n "$$PUSH_IMAGE_REPO" ]; then \
		$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) nemoclaw-sandbox "$$PUSH_IMAGE_REPO" $(IMAGE_TAG); \
	else echo "Image kept in $(BUILD_NS); set IMAGE_REPO to your own namespace to push."; fi

cli-build: .check-image-repo ## Build the NemoClaw CLI image in-cluster (IMAGE_REPO opts into pushing)
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	@oc delete is nemoclaw-cli -n "$(BUILD_NS)" --ignore-not-found=true
	helm upgrade --install nemoclaw-cli-imagestream $(HELM_DIR)nemoclaw-cli-imagestream \
		--namespace $(BUILD_NS) --create-namespace
	oc start-build nemoclaw-cli -n $(BUILD_NS) --follow
	@if [ -n "$$PUSH_IMAGE_REPO" ]; then \
		$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) nemoclaw-cli "$$PUSH_IMAGE_REPO" $(IMAGE_TAG); \
	else echo "Image kept in $(BUILD_NS); set IMAGE_REPO to your own namespace to push."; fi

# --- Governance interceptor image ---

governance-interceptor-build: .check-image-repo ## Build the governance interceptor in-cluster (IMAGE_REPO opts into pushing)
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	@oc delete is governance-interceptor -n "$(BUILD_NS)" --ignore-not-found=true
	helm upgrade --install governance-interceptor-image $(HELM_DIR)governance-interceptor-image \
		--namespace $(BUILD_NS) --create-namespace \
		--set source.git.ref=$(OPENSHELL_INTERCEPTOR_REF) \
		--set-string output.externalImage=$(if $(PUSH_IMAGE_REPO),$(PUSH_IMAGE_REPO)/governance-interceptor:$(OPENSHELL_INTERCEPTOR_REF)) \
		--set-string output.imageStreamTag=$(if $(PUSH_IMAGE_REPO),,governance-interceptor:$(OPENSHELL_INTERCEPTOR_REF))
	oc start-build governance-interceptor -n $(BUILD_NS) --follow
	@echo "Image built in $(BUILD_NS)$(if $(PUSH_IMAGE_REPO), and pushed to $(PUSH_IMAGE_REPO))."

governance-interceptor-build-local: ## Build the governance interceptor image in the cluster
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	helm upgrade --install governance-interceptor-image $(HELM_DIR)governance-interceptor-image \
		--namespace $(BUILD_NS) --create-namespace \
		--set source.git.ref=$(OPENSHELL_INTERCEPTOR_REF) \
		--set output.externalImage= \
		--set output.imageStreamTag=governance-interceptor:v$(patsubst v%,%,$(OPENSHELL_INTERCEPTOR_REF))
	oc start-build governance-interceptor -n $(BUILD_NS) --follow

# --- Gateway VM image ---

gateway-build-docker: .check-image-repo ## Build the Docker gateway image in-cluster (IMAGE_REPO opts into pushing)
	@echo "Building Docker gateway image (openshell-gateway-docker)..."
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	@oc delete dv openshell-gateway-docker-golden -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete datasource openshell-gateway-docker -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete pvc openshell-gateway-docker-golden -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete builds -l buildconfig=openshell-gateway-docker -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete is openshell-gateway-docker -n "$(BUILD_NS)" --ignore-not-found=true
	@resources=$$(oc api-resources --api-group=cdi.kubevirt.io -o name) || exit $$?; \
	GOLDEN_FLAG=""; \
	if ! printf '%s\n' "$$resources" | grep -q '^datavolumes.cdi.kubevirt.io$$'; then \
		GOLDEN_FLAG="--set goldenImage.enabled=false"; \
	fi; \
	helm upgrade --install openshell-gateway-docker-image $(HELM_DIR)openshell-gateway-image \
		--namespace $(BUILD_NS) --create-namespace $$GOLDEN_FLAG \
		--set containerRuntime=docker
	oc start-build openshell-gateway-docker -n $(BUILD_NS) --follow
	@if [ -n "$$PUSH_IMAGE_REPO" ]; then \
		$(SCRIPTS_DIR)/push-image.sh $(BUILD_NS) openshell-gateway-docker "$$PUSH_IMAGE_REPO" $(IMAGE_TAG); \
	else echo "Image kept in $(BUILD_NS); set IMAGE_REPO to your own namespace to push."; fi

gateway-build-podman: .check-image-repo ## Build the Podman gateway image in-cluster (IMAGE_REPO opts into pushing)
	@echo "Building Podman gateway image (openshell-gateway)..."
	@oc create namespace "$(BUILD_NS)" --dry-run=client -o yaml | oc apply -f -
	@oc delete dv openshell-gateway-golden -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete datasource openshell-gateway -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete pvc openshell-gateway-golden -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete builds -l buildconfig=openshell-gateway -n "$(BUILD_NS)" --ignore-not-found=true
	@oc delete is openshell-gateway -n "$(BUILD_NS)" --ignore-not-found=true
	@resources=$$(oc api-resources --api-group=cdi.kubevirt.io -o name) || exit $$?; \
	GOLDEN_FLAG=""; \
	if ! printf '%s\n' "$$resources" | grep -q '^datavolumes.cdi.kubevirt.io$$'; then \
		GOLDEN_FLAG="--set goldenImage.enabled=false"; \
	fi; \
	helm upgrade --install openshell-gateway-image $(HELM_DIR)openshell-gateway-image \
		--namespace $(BUILD_NS) --create-namespace $$GOLDEN_FLAG \
		--set containerRuntime=podman
