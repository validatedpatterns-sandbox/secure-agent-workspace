    "personal-assistant": {
      "description": "Personal assistant: NemoClaw agent with NVIDIA inference and a daily Slack and Gmail briefing",
      "harnessRequired": true,
      "secrets": {
        "gmail": {
          "fields": [
            {
              "key": "client_id",
              "kind": "secret",
              "refreshMaterial": true,
              "required": true,
              "title": "Google OAuth client ID"
            },
            {
              "key": "client_secret",
              "kind": "secret",
              "refreshMaterial": true,
              "required": true,
              "title": "Google OAuth client secret"
            },
            {
              "key": "refresh_token",
              "kind": "secret",
              "refreshMaterial": true,
              "required": true,
              "title": "Google OAuth refresh token (scope gmail.readonly)"
            }
          ],
          "provider": "gmail",
          "providers": [
            "gmail"
          ],
          "refresh": {
            "credentialKey": "access_token",
            "strategy": "oauth2_refresh_token"
          }
        },
        "inference": {
          "fields": [
            {
              "key": "api_key",
              "kind": "secret",
