#!/usr/bin/env python3
"""Fake podman for installer tests. Every call is appended to podman.log.

State lives in $FAKE_STATE:
  images.json      image -> content. Component images map a path in the image
                   to {"type": "binary", "version": v} or {"type": "nemoclaw"}.
                   A harness bundle image is {"__tree__": {relpath: text}}: a
                   FROM-scratch image whose root is the bundle tree.
  containers.json  container id -> image, for `create` / `cp` / `export`.
  volumes/<name>/  named volumes, as real directories (`volume create`,
                   `inspect`, `ls`, `import` with tar filter='data', `rm`,
                   which refuses a volume a sandbox mounts);
                   volume-labels.json holds their labels.
  openshell.json   read-only here: the fake openshell's sandboxes. `ps` and
                   `inspect` present each one as a sandbox container with the
                   labels and `.Mounts` the real OpenShell podman driver sets
                   (see ProfileApplier.sandbox_harness_mount).

`pull --signature-policy <path> <image>` reads the policy file ComponentInstaller
generates and simulates real enforcement: a "reject" default always fails
(no signer configured); a "sigstoreSigned" default fails only for an image
listed in unsigned.json (this fake has no real keys or signatures to check,
so unsigned.json is the fixture's way of saying "would not verify"). A
plain `pull` with no --signature-policy always succeeds when the image is
known, exactly like today's non-signature-checking extraction pulls.
"""
import io
import json
import os
import subprocess
import sys
import tarfile
from pathlib import Path

state = Path(os.environ["FAKE_STATE"])
args = sys.argv[1:]
with open(state / "podman.log", "a") as log:
    log.write(json.dumps(args) + "\n")

images = json.loads((state / "images.json").read_text()) if (state / "images.json").exists() else {}
containers_file = state / "containers.json"
containers = json.loads(containers_file.read_text()) if containers_file.exists() else {}

cmd = args[0] if args else ""


def sandboxes():
    """{"<workspace>/<sandbox>": sandbox} from the fake openshell's state."""
    osh = state / "openshell.json"
    return json.loads(osh.read_text()).get("sandboxes", {}) if osh.exists() else {}


def container_name(key):
    """Like the real driver: openshell-<workspace>--<sandbox>-<uuid>."""
    workspace, sandbox = key.split("/", 1)
    return f"openshell-{workspace}--{sandbox}-0000"


if cmd == "pull":
    image = args[-1]
    if image not in images:
        print(f"Error: initializing source docker://{image}: manifest unknown", file=sys.stderr)
        sys.exit(125)
    policy_path = args[args.index("--signature-policy") + 1] if "--signature-policy" in args else None
    if policy_path:
        policy = json.loads(Path(policy_path).read_text())
        default = (policy.get("default") or [{}])[0]
        unsigned_file = state / "unsigned.json"
        unsigned = json.loads(unsigned_file.read_text()) if unsigned_file.exists() else []
        if default.get("type") == "reject":
            print("Error: no valid signature: policy default is reject", file=sys.stderr)
            sys.exit(125)
        if default.get("type") == "sigstoreSigned" and image in unsigned:
            print(f"Error: image {image}: signature verification failed", file=sys.stderr)
            sys.exit(125)
    images[image]["pulled"] = True      # so `image exists` sees it afterwards
    (state / "images.json").write_text(json.dumps(images))
    print("sha256:" + "0" * 64)
elif cmd == "create":
    positional = [a for a in args[1:] if not a.startswith("-")]
    image = positional[0]
    cid = f"c{len(containers) + 1:04d}"
    containers[cid] = image
    containers_file.write_text(json.dumps(containers))
    print(cid)
elif cmd == "cp":
    src, dest = args[1], Path(args[2])
    cid, path = src.split(":", 1)
    content = images.get(containers.get(cid, ""), {}).get(path)
    if content is None:
        print(f"Error: \"{path}\" could not be found on container {cid}", file=sys.stderr)
        sys.exit(125)
    if content["type"] == "binary":
        dest.write_text("#!/bin/sh\n"
                        f"if [ \"$1\" = --version ]; then echo \"{dest.name} {content['version']}\"; exit 0; fi\n"
                        "exit 0\n")
    elif content["type"] == "nemoclaw":
        (dest / "bin").mkdir(parents=True)
        (dest / "bin" / "nemoclaw.js").write_text("console.log('nemoclaw')\n")
elif cmd == "export":
    # Container filesystem of a harness image: __tree__ keys are tar member
    # names as-is (including unsafe ones), so read_harness_tar's path checks
    # are exercised the same way a real podman export would.
    out = Path(args[args.index("-o") + 1])
    cid = args[-1]
    tree = images.get(containers.get(cid, ""), {}).get("__tree__")
    if tree is None:
        print(f"Error: no such container {cid}", file=sys.stderr)
        sys.exit(125)
    with tarfile.open(out, "w") as tar:
        for rel, text in sorted(tree.items()):
            data = text.encode() if isinstance(text, str) else text
            info = tarfile.TarInfo(rel)
            info.size = len(data)
            info.mode = 0o755 if rel.endswith(".sh") else 0o644
            tar.addfile(info, io.BytesIO(data))
elif cmd == "image" and args[1] == "exists":
    sys.exit(0 if args[-1] in images and "pulled" in images[args[-1]] else 1)
elif cmd == "ps":
    # Only the label filters the installer uses: sandbox name, workspace and
    # isolation role. Like 0.1.x, each sandbox is two containers with the
    # same sandbox labels: its supervisor (listed first, no user mounts) and
    # the workload (openshell.ai/isolation-role=sandbox).
    labels = dict(a.split("=", 1)[1].split("=", 1) for a in args if a.startswith("label="))
    for key in sandboxes():
        workspace, sandbox = key.split("/", 1)
        if labels.get("openshell.ai/sandbox-name", sandbox) == sandbox and \
                labels.get("openshell.ai/sandbox-workspace", workspace) == workspace:
            role = labels.get("openshell.ai/isolation-role")
            if role in (None, "supervisor"):
                print(f"openshell-supervisor-{workspace}-{sandbox}")
            if role in (None, "sandbox"):
                print(container_name(key))
elif cmd == "inspect":
    # `.Mounts` of a sandbox container, in the shape podman 5.8 prints: an
    # image mount's Source is the image reference given at create.
    if args[-1].startswith("openshell-supervisor-"):
        print("[]")     # the supervisor container has none of the user's mounts
        sys.exit(0)
    sb = next((v for k, v in sandboxes().items() if container_name(k) == args[-1]), None)
    if sb is None:
        print(f"Error: no such object: {args[-1]}", file=sys.stderr)
        sys.exit(125)
    if "{{json .HostConfig.Binds}}" in args:
        print(json.dumps(sb.get("identityBinds", [])))
        sys.exit(0)
    mounts = []
    for m in ((sb.get("driverConfig") or {}).get("podman") or {}).get("mounts", []):
        if m["type"] == "image":
            mounts.append({"Type": "image", "Source": m["source"],
                           "Destination": m["target"], "RW": False})
        else:
            mounts.append({"Type": "volume", "Name": m["source"],
                           "Source": str(state / "volumes" / m["source"] / "_data"),
                           "Destination": m["target"],
                           "RW": not m.get("read_only", True)})
    print(json.dumps(mounts))
elif cmd == "volume":
    # Named volumes as real directories under volumes/<name>; their labels
    # (which OpenShell 0.1.x admission checks) in volume-labels.json.
    import shutil
    volumes = state / "volumes"
    volumes.mkdir(exist_ok=True)
    labels_file = state / "volume-labels.json"
    all_labels = json.loads(labels_file.read_text()) if labels_file.exists() else {}
    sub, name = args[1], args[-1]

    def in_use(volume):
        for sb in sandboxes().values():
            for m in ((sb.get("driverConfig") or {}).get("podman") or {}).get("mounts", []):
                if m["type"] == "volume" and m["source"] == volume:
                    return True
        return False

    if sub == "create":
        if (volumes / name).is_dir():
            print(f"Error: volume with name {name} already exists: volume already exists",
                  file=sys.stderr)
            sys.exit(125)
        (volumes / name).mkdir()
        all_labels[name] = dict(args[i + 1].split("=", 1) for i, a in enumerate(args) if a == "--label")
        labels_file.write_text(json.dumps(all_labels))
        print(name)
    elif sub == "exists":
        sys.exit(0 if (volumes / name).is_dir() else 1)
    elif sub == "inspect":
        if not (volumes / name).is_dir():
            print(f"Error: no such volume {name}", file=sys.stderr)
            sys.exit(125)
        print(json.dumps([{"Name": name, "Driver": "local", "Mountpoint": str(volumes / name),
                           "Labels": all_labels.get(name, {})}]))
    elif sub == "ls":
        for entry in sorted(volumes.iterdir()):
            if entry.is_dir():
                print(entry.name)
    elif sub == "import":
        # filter='data': refuse absolute / .. members the way a careful
        # extract should; unfiltered extractall would hide write_harness_tar bugs.
        name, tarball = args[2], args[3]
        fail_file = state / "import-fail.json"
        if fail_file.exists() and name in json.loads(fail_file.read_text()):
            print(f"Error: volume import {name} failed", file=sys.stderr)
            sys.exit(125)
        with tarfile.open(tarball) as tar:
            tar.extractall(volumes / name, filter="data")
    elif sub == "rm":
        if not (volumes / name).is_dir():
            print(f"Error: no volume with name \"{name}\" found", file=sys.stderr)
            sys.exit(1)
        if in_use(name):
            print(f"Error: volume {name} is being used by the following container(s): c0001",
                  file=sys.stderr)
            sys.exit(2)
        shutil.rmtree(volumes / name)
        all_labels.pop(name, None)
        labels_file.write_text(json.dumps(all_labels))
elif cmd == "unshare":
    # No user namespace in tests: run the command as is.
    sys.exit(subprocess.run(args[1:]).returncode)
elif cmd == "rmi":
    image = args[-1]
    if image not in images:
        print(f"Error: {image}: image not known", file=sys.stderr)
        sys.exit(125)
    del images[image]
    (state / "images.json").write_text(json.dumps(images))
elif cmd in ("rm", "exec"):
    pass
else:
    print(f"fake podman: unsupported {args}", file=sys.stderr)
    sys.exit(2)
