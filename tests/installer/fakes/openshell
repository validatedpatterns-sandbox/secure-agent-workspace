#!/usr/bin/env python3
"""Fake, stateful OpenShell CLI for installer tests.

State lives in openshell.json; every call is appended to openshell.log.
deny.json lists operations (e.g. "workspace create") that fail with a
permission error, to test error paths.
"""
import json
import os
import re
import shlex
import sys
from pathlib import Path

state_dir = Path(os.environ["FAKE_STATE"])
raw_args = sys.argv[1:]
args = raw_args[2:] if raw_args[:1] == ["--gateway"] else raw_args
with open(state_dir / "openshell.log", "a") as log:
    log.write(json.dumps(args) + "\n")
with open(state_dir / "openshell-env.log", "a") as log:
    log.write(json.dumps({"args": raw_args, "xdg": os.environ.get("XDG_CONFIG_HOME", ""),
                          "gateway": os.environ.get("OPENSHELL_GATEWAY", "")}) + "\n")

state_file = state_dir / "openshell.json"
state = json.loads(state_file.read_text()) if state_file.exists() else {
    "gateways": [], "selected": None, "workspaces": ["default"], "members": [],
    "providers": {}, "sandboxes": {}, "inference": {}, "system_inference": None}
deny = json.loads((state_dir / "deny.json").read_text()) if (state_dir / "deny.json").exists() else []
no_profiles = (json.loads((state_dir / "no-profiles.json").read_text())
               if (state_dir / "no-profiles.json").exists() else [])


def save():
    state_file.write_text(json.dumps(state))


def opt(name, default=None):
    return args[args.index(name) + 1] if name in args else default


def fail(message, code=1):
    print(message, file=sys.stderr)
    save()
    sys.exit(code)


def credential():
    """Like the real CLI: `--credential NAME` reads $NAME, `NAME=value` is literal."""
    spec = opt("--credential")
    if spec is None:
        return None
    if "=" in spec:
        return spec
    if spec not in os.environ:
        fail(f"Error: environment variable {spec} is not set")
    return f"{spec}={os.environ[spec]}"


if "--" in args:
    head = args[:args.index("--")]
else:
    head = args
op = " ".join(head[:2])
if op in deny:
    fail("Error: permission denied (requires platform admin)")
if op == "workspace create" and (state_dir / "rbac").exists():
    # OIDC RBAC: platform-admin methods need the admin role; an mTLS caller's
    # roles come from its certificate's OU.
    selected = (state.get("admin_gateway") if os.environ.get("OPENSHELL_GATEWAY") == "saw-installer"
                else next((g for g in state["gateways"] if g["name"] == state["selected"]), {})) or {}
    if "openshell-admin" not in selected.get("roles", []):
        fail("Error: permission denied (requires platform admin)")
    tls_dir = selected.get("tls_dir")
    if tls_dir:
        import subprocess
        bundle = Path(os.environ["HOME"]) / ".local/state/openshell/tls/client-ca.pem"
        if subprocess.run(["openssl", "verify", "-CAfile", str(bundle),
                           str(Path(tls_dir) / "client/tls.crt")],
                          capture_output=True).returncode:
            fail("Error: admin certificate issuer is not trusted")
ws = opt("--workspace", "default")

def label_key(kind, workspace, name):
    return f"{kind}/{workspace}/{name}"


def remember_labels(kind, workspace, name):
    labels = [args[i + 1] for i, arg in enumerate(args) if arg == "--label"]
    if labels:
        state.setdefault("labels", {})[label_key(kind, workspace, name)] = labels


def stored_labels(kind, workspace, name):
    return state.get("labels", {}).get(label_key(kind, workspace, name), [])


def labels_dict(kind, workspace, name):
    """`--label key=value` args, as the CLI stores them, split into a map."""
    parsed = {}
    for item in stored_labels(kind, workspace, name):
        key, sep, value = item.partition("=")
        parsed[key] = value if sep else ""
    return parsed


def output_format():
    if "--output" in args:
        return opt("--output")
    if "-o" in args:
        return opt("-o")
    return None


def cert_roles(tls_dir):
    """OUs of the client certificate `gateway add --local` would import."""
    import subprocess
    subject = subprocess.run(["openssl", "x509", "-noout", "-subject", "-nameopt", "sep_multiline",
                              "-in", str(Path(tls_dir) / "client" / "tls.crt")],
                             capture_output=True, text=True, check=True).stdout
    return [line.split("=", 1)[1] for line in subject.splitlines() if line.strip().startswith("OU=")]


if head[0] == "gateway":
    if head[1] == "add":
        tls_dir = os.environ.get("OPENSHELL_LOCAL_TLS_DIR")
        # Without an override, --local imports the gateway's own client
        # certificate, which carries OU=openshell-user.
        roles = cert_roles(tls_dir) if tls_dir else ["openshell-user"]
        state["gateways"].append({"name": opt("--name"), "endpoint": head[2], "local": "--local" in head,
                                  "roles": roles})
        if opt("--name") == "saw-installer" and tls_dir:
            state["admin_gateway"] = {"roles": roles, "tls_dir": tls_dir,
                                      "config_home": os.environ.get("XDG_CONFIG_HOME", "")}
    elif head[1] == "remove":
        state["gateways"] = [g for g in state["gateways"] if g["name"] != head[2]]
    elif head[1] == "select":
        state["selected"] = head[2]
elif op == "workspace list":
    print("NAME STATUS LABELS")
    for w in state["workspaces"]:
        labels = ",".join(state.get("labels", {}).get(label_key("workspace", "", w), []))
        print(f"{w} Active {labels}")
elif op == "workspace get":
    # OpenShell 0.0.116 and 0.1.2 have no --output flag here. Human text is
    # `Labels: key=value, key2=value2`.
    name = head[2]
    if name not in state["workspaces"]:
        fail("Error: workspace not found")
    labels = ",".join(stored_labels("workspace", "", name))
    print(f"Name: {name}\nLabels: {labels}")
elif op == "workspace create":
    name = opt("--name")
    if name in state["workspaces"]:
        fail(f"Error: workspace {name} already exists")
    state["workspaces"].append(name)
    remember_labels("workspace", "", name)
elif op == "workspace delete":
    # OpenShell 0.1.2 does not pass allow_missing here (sandbox delete and
    # provider delete do). Deleting a workspace the user already removed fails.
    name = head[2]
    if name == "default":
        fail("Error: cannot delete the default workspace")
    if name not in state["workspaces"]:
        fail(f"Error: workspace '{name}' not found")
    state["workspaces"] = [w for w in state["workspaces"] if w != name]
elif op == "workspace member":
    if head[2] == "remove":
        before = len(state["members"])
        state["members"] = [m for m in state["members"]
                            if m[:2] != [opt("--workspace"), opt("--subject")]]
        if len(state["members"]) == before:
            fail("Error: member not found")
    else:
        member = [opt("--workspace"), opt("--subject"), opt("--role")]
        if member in state["members"]:
            fail("Error: member already exists")
        state["members"].append(member)
elif op == "provider list-profiles":
    # catalog.json: {"<profile id>": ["<endpoint host>", ...]}; the default
    # stands in for the governance interceptor's catalog.
    catalog = (json.loads((state_dir / "catalog.json").read_text())
               if (state_dir / "catalog.json").exists() else {
                   "web-search": ["api.tavily.com", "api.search.brave.com", "registry.npmjs.org"],
                   "brave": ["api.search.brave.com"], "nvidia": ["integrate.api.nvidia.com"],
                   "github": ["api.github.com"]})
    print(json.dumps([{"id": pid, "endpoints": [{"host": h, "port": 443} for h in hosts]}
                      for pid, hosts in sorted(catalog.items())]))
elif op == "provider profile" and head[2] == "import":
    # Like the gateway: needs an `id`, scoped to the workspace, reserved if present.
    import yaml
    doc = yaml.safe_load(Path(opt("-f")).read_text())
    if not isinstance(doc, dict) or not doc.get("id"):
        fail("Error: failed to parse provider profile YAML: missing field `id`")
    imported = state.setdefault("imported_profiles", {})
    if doc["id"] in imported.get(ws, []):
        fail(f"Error: provider profile '{doc['id']}' already exists")
    imported.setdefault(ws, []).append(doc["id"])
    print(f"Imported provider profile {doc['id']}")
elif op == "provider profile" and head[2] == "delete":
    imported = state.setdefault("imported_profiles", {})
    imported[ws] = [item for item in imported.get(ws, []) if item != head[3]]
elif op == "provider create":
    if opt("--type") in no_profiles and opt("--type") not in state.get("imported_profiles", {}).get(ws, []):
        # Wording of OpenShell 0.0.116 when governance does not serve the profile.
        fail(f"Error:   × unsupported provider type or profile: {opt('--type')} (provider profile "
             f"'{opt('--type')}' not\n  │ found; import a matching profile before using this provider type)")
    key = f"{ws}/{opt('--name')}"
    if key in state["providers"]:
        fail(f"Error: provider {opt('--name')} already exists")
    state["providers"][key] = {"type": opt("--type"), "credential": credential()}
    configs = [head[i + 1] for i, a in enumerate(head) if a == "--config"]
    if configs:
        state["providers"][key]["config"] = configs
elif op == "provider update":
    key = f"{ws}/{head[2]}"
    if key not in state["providers"]:
        fail("Error: provider not found")
    state["providers"][key]["credential"] = credential()
    configs = [head[i + 1] for i, a in enumerate(head) if a == "--config"]
    if configs:
        state["providers"][key]["config"] = configs
elif op == "provider get":
    if f"{ws}/{head[2]}" not in state["providers"]:
        fail("Error: provider not found")
    print(f"Name: {head[2]}")
elif op == "provider list":
    print("NAME TYPE")
    for key in sorted(state["providers"]):
        owner, name = key.split("/", 1)
        if owner == ws:
            print(f"{name} {state['providers'][key]['type']}")
elif op == "provider delete":
    # The gateway refuses to delete a provider a sandbox still uses.
    # Leaving the object in state is the point: the installer must notice
    # the non-zero exit and keep the ledger entry.
    name = head[2]
    for key, sb in state["sandboxes"].items():
        owner, _sb_name = key.split("/", 1)
        if owner == ws and name in sb.get("providers", []):
            fail(f"Error: provider '{name}' is attached to a sandbox")
    state["providers"].pop(f"{ws}/{name}", None)
elif op == "inference set":
    if "--system" in head:
        # Like the real gateway: the system route's provider must exist in 'default'.
        if f"default/{opt('--provider')}" not in state["providers"]:
            fail(f"Error: provider '{opt('--provider')}' not found in workspace 'default'")
        state["system_inference"] = [opt("--provider"), opt("--model")]
    else:
        state["inference"][ws] = [opt("--provider"), opt("--model")]
elif op == "inference delete":
    if "--system" in head:
        state["system_inference"] = None
    else:
        state["inference"].pop(ws, None)
elif op == "sandbox list":
    print("NAME PHASE")
    for key in sorted(state["sandboxes"]):
        owner, name = key.split("/", 1)
        if owner == ws:
            print(f"{name} {state['sandboxes'][key]['phase']}")
elif op == "sandbox get":
    # OpenShell 0.0.116 and 0.1.2: `--output json` is a labels object; human
    # text is one `key: value` line per label. `reject-json` simulates a CLI
    # that does not accept the flag.
    name = head[2]
    fmt = output_format()
    if fmt == "json" and (state_dir / "reject-json").exists():
        fail("error: unexpected argument '--output' found")
    key = f"{ws}/{name}"
    sb = state["sandboxes"].get(key)
    # "after": [gets, then]: the phase changes after that many gets; then
    # "gone" ends a deletion (real deletes are asynchronous).
    if sb and sb.get("after"):
        gets, then = sb["after"]
        if gets <= 0:
            if then == "gone":
                state["sandboxes"].pop(key)
                sb = None
            else:
                sb["phase"], sb["after"] = then, None
        else:
            sb["after"] = [gets - 1, then]
    if not sb:
        fail(f"Error: sandbox '{name}' not found")
    labels = labels_dict("sandbox", ws, name)
    if fmt == "json":
        print(json.dumps({"name": name, "phase": sb["phase"], "workspace": ws, "labels": labels}))
    else:
        print(f"Name: {name}\nPhase: {sb['phase']}")
        if labels:
            print("Labels:")
            for key, value in labels.items():
                print(f"  {key}: {value}")
elif op == "sandbox create":
    key = f"{ws}/{opt('--name')}"
    if key in state["sandboxes"]:
        fail(f"Error:   x sandbox '{opt('--name')}' already exists")
    providers = [head[i + 1] for i, a in enumerate(head) if a == "--provider"]
    missing = [p for p in providers if f"{ws}/{p}" not in state["providers"]]
    if missing:
        fail(f"Error: provider '{missing[0]}' not found")
    state["sandboxes"][key] = {"image": opt("--from"), "providers": providers, "phase": "Ready"}
    remember_labels("sandbox", ws, opt("--name"))
    if opt("--driver-config-json"):
        state["sandboxes"][key]["driverConfig"] = json.loads(opt("--driver-config-json"))
elif op == "sandbox delete":
    key = f"{ws}/{head[2]}"
    delay = state.get("deleteDelay", 0)
    if delay and key in state["sandboxes"]:
        state["sandboxes"][key].update(phase="Deleting", after=[delay, "gone"])
    else:
        state["sandboxes"].pop(key, None)
elif op == "sandbox exec":
    if args[-2:] in (["id", "-u"], ["id", "-g"]):
        print("1000")
        save()
        sys.exit(0)
    # notReadyExecs: the first N execs fail like a sandbox still provisioning.
    if state.get("notReadyExecs", 0) > 0:
        state["notReadyExecs"] -= 1
        fail(f"Error:   x sandbox '{opt('-n')}' is not ready (phase: Provisioning)")
    # A file inside a volume mounted with --driver-config-json: read it from
    # the fake podman's volume directory, as the real mount would show it.
    if len(args) >= 2 and args[-2] == "cat":
        sb = state["sandboxes"].get(f"{ws}/{opt('-n')}") or {}
        # The installer's record of the MCP servers it declared in openclaw.json.
        if args[-1] == "/sandbox/.openclaw/saw-mcp-servers.json":
            if "sawMcpState" not in sb:
                fail(f"cat: {args[-1]}: No such file or directory", 1)
            print(sb["sawMcpState"])
            save()
            sys.exit(0)
        for mount in ((sb.get("driverConfig") or {}).get("podman") or {}).get("mounts", []):
            target = mount["target"].rstrip("/") + "/"
            if args[-1].startswith(target):
                rel = args[-1][len(target):]
                if mount["type"] == "image":
                    images_file = state_dir / "images.json"
                    images = json.loads(images_file.read_text()) if images_file.exists() else {}
                    tree = images.get(mount["source"], {}).get("__tree__", {})
                    if rel in tree:
                        print(tree[rel], end="")
                        save()
                        sys.exit(0)
                path = state_dir / "volumes" / mount["source"] / rel
                if mount["type"] == "volume" and path.is_file():
                    print(path.read_text(), end="")
                    save()
                    sys.exit(0)
        fail(f"cat: {args[-1]}: No such file or directory", 1)
    if len(args) >= 2 and args[-2] == "sha256sum":
        import hashlib
        sb = state["sandboxes"].get(f"{ws}/{opt('-n')}") or {}
        for mount in ((sb.get("driverConfig") or {}).get("podman") or {}).get("mounts", []):
            target = mount["target"].rstrip("/") + "/"
            if args[-1].startswith(target) and mount["type"] == "volume":
                rel = args[-1][len(target):]
                file = state_dir / "volumes" / mount["source"] / rel
                if file.is_file():
                    print(f"{hashlib.sha256(file.read_bytes()).hexdigest()}  {args[-1]}")
                    save()
                    sys.exit(0)
        fail(f"sha256sum: {args[-1]}: No such file or directory", 1)
    sb = state["sandboxes"].get(f"{ws}/{opt('-n')}") or {}
    mounts = ((sb.get("driverConfig") or {}).get("podman") or {}).get("mounts", [])

    def harness_files():
        for mount in mounts:
            if mount["target"].rstrip("/") != "/sandbox/harness":
                continue
            if mount["type"] == "image":
                images_file = state_dir / "images.json"
                images = json.loads(images_file.read_text()) if images_file.exists() else {}
                return images.get(mount["source"], {}).get("__tree__", {})
            root = state_dir / "volumes" / mount["source"]
            if root.is_dir():
                return {str(p.relative_to(root)): p.read_text()
                        for p in root.rglob("*") if p.is_file()}
        return {}

    script = args[-1] if args else ""
    if 'const file = "/sandbox/.openclaw/openclaw.json"' in script:
        cfg = sb.setdefault("openclawConfig", {})
        paths = cfg.get("plugins.load.paths") or []
        cfg["plugins.load.paths"] = list(dict.fromkeys([*paths, "/sandbox/.saw/trusted/plugin"]))
        allowed = cfg.get("plugins.allow") or []
        if allowed:
            cfg["plugins.allow"] = list(dict.fromkeys([*allowed, "saw-tool-gate"]))
        cfg["plugins.entries.saw-tool-gate"] = {"enabled": True}
        save()
        sys.exit(0)
    if 'printenv "$v"' in script:
        # mcp_trust_env_probe: the CA settings the sandbox has (trustEnv;
        # default: all of them, as with the proxy CA). trustProbeFails: the
        # probe's exec fails.
        if state.get("trustProbeFails"):
            fail("Error:   x exec failed", 1)
        names = re.search(r"for v in (.*?); do", script).group(1).split()
        have = sb.get("trustEnv", names)
        print("\n".join(n for n in names if n in have))
        save()
        sys.exit(0)
    if "saw-mcp-servers.json" in script:
        # configure_harness_mcp: unset/set mcp.servers.<name>, then record them.
        # The script runs under set -e: mcp-set-fails.json (server names)
        # stops it at that server's set, before the record is written.
        cfg = sb.setdefault("openclawConfig", {})
        fails_file = state_dir / "mcp-set-fails.json"
        failing = set(json.loads(fails_file.read_text())) if fails_file.exists() else set()
        for line in script.splitlines():
            m = re.search(r"openclaw config unset (mcp\.servers\.\S+)", line)
            if m:
                cfg.pop(m.group(1), None)
            m = re.search(r"openclaw config set (mcp\.servers\.\S+)\s+(.*)", line)
            if m:
                if m.group(1).split(".", 2)[2] in failing:
                    sb["mcpWrites"] = sb.get("mcpWrites", 0) + 1
                    save()
                    fail(f"Error: Config validation failed: {m.group(1)}", 1)
                cfg[m.group(1)] = json.loads(shlex.split(m.group(2))[0])
            m = re.search(r"printf '%s\\n' (.*) > /sandbox/.openclaw/saw-mcp-servers.json", line)
            if m:
                sb["sawMcpState"] = shlex.split(m.group(1))[0]
        sb["mcpWrites"] = sb.get("mcpWrites", 0) + 1
        save()
        sys.exit(0)
    if "openclaw config set " in script:
        m = re.search(r"openclaw config set (\S+)\s+(.*)", script)
        if m:
            key, rest = m.group(1), m.group(2).strip()
            try:
                tokens = shlex.split(rest)
                val = json.loads(tokens[0]) if tokens else None
            except (ValueError, json.JSONDecodeError):
                val = rest.strip("'\"")
            if key.startswith(("plugins.load", "skills.load")):
                sb.setdefault("openclawConfig", {})[key] = val
            save()
            sys.exit(0)
    if "openclaw config unset " in script:
        m = re.search(r"openclaw config unset (\S+)", script)
        if m:
            (sb.get("openclawConfig") or {}).pop(m.group(1), None)
            save()
            sys.exit(0)
    if "openclaw config get " in script:
        m = re.search(r"openclaw config get (\S+)", script)
        if m:
            val = (sb.get("openclawConfig") or {}).get(m.group(1))
            if val is None:
                sys.exit(1)
            print(json.dumps(val))
            save()
            sys.exit(0)
    if "openclaw plugins inspect " in script:
        # mcp-inspect.json overrides: {"<bundle>": ["server", ...]} (omit the
        # bundle, or give it an empty list, to simulate a dropped server).
        m = re.search(r"openclaw plugins inspect (\S+)", script)
        bundle = m.group(1) if m else ""
        override = state_dir / "mcp-inspect.json"
        override_data = json.loads(override.read_text()) if override.exists() else {}
        if bundle in override_data:
            servers = override_data[bundle]
        else:
            files = harness_files()
            try:
                decl = json.loads(files.get("mcp.json", "{}")).get("mcpServers", {})
            except ValueError:
                decl = {}
            servers = sorted(decl)
        if "--json" in script:
            print(json.dumps({"plugin": {"id": bundle, "status": "loaded", "enabled": True},
                              "mcpServers": [{"name": name} for name in servers], "diagnostics": []}))
        else:
            print("MCP servers:")
            for name in servers:
                print(name)
        save()
        sys.exit(0)
    if "openclaw plugins list --json" in script:
        # plugins-list.json overrides the listing (a bundle OpenClaw has not
        # loaded, or output that does not parse).
        override = state_dir / "plugins-list.json"
        if override.exists():
            print(override.read_text(), end="")
            save()
            sys.exit(0)
        # Pinned OpenClaw 2026.9.6 `--json` shape: bundle row plus native ids.
        # `mcp list` is not modelled (it never shows bundle servers).
        import yaml as _yaml
        files = harness_files()
        try:
            name = (_yaml.safe_load(files.get("harness.yaml", "")) or {}).get("metadata", {}).get("name", "")
        except ValueError:
            name = ""
        caps = []
        if any(rel.startswith("skills/") for rel in files):
            caps.append("skills")
        if "mcp.json" in files:
            caps.append("mcpServers")
        plugins = [{"id": name, "name": name, "format": "bundle",
                    "source": "$OPENCLAW_HOME/harness", "rootDir": "/sandbox/harness",
                    "enabled": True, "status": "loaded", "bundleCapabilities": caps}]
        for pname in sorted({rel.split("/")[1] for rel in files
                             if rel.startswith("plugins/") and rel.count("/") >= 2}):
            plugins.append({"id": pname, "name": pname, "format": "openclaw",
                            "enabled": True, "status": "loaded"})
        cfg = sb.get("openclawConfig") or {}
        gate_mount = next((m for m in mounts if m["target"] == "/sandbox/.saw/trusted"), None)
        if gate_mount and cfg.get("plugins.entries.saw-tool-gate", {}).get("enabled"):
            loaded = "/sandbox/.saw/trusted/plugin" in (cfg.get("plugins.load.paths") or [])
            plugins.append({"id": "saw-tool-gate", "name": "SAW tool gate", "format": "openclaw",
                            "rootDir": "/sandbox/.saw/trusted/plugin" if loaded else "",
                            "enabled": loaded, "status": "loaded" if loaded else "disabled"})
        print(json.dumps({"plugins": plugins}))
        save()
        sys.exit(0)
    failing = (json.loads((state_dir / "exec-fail.json").read_text())
               if (state_dir / "exec-fail.json").exists() else [])
    probe = args[-1:] == ["true"]
    if opt("-n") in failing and not probe:
        fail("sh: line 1: /usr/local/sbin/openclaw: Permission denied", 126)
    # exec-output.json: {"<substring of the command>": "<stderr to print>"}
    outputs = (json.loads((state_dir / "exec-output.json").read_text())
               if (state_dir / "exec-output.json").exists() else {})
    for needle, text in outputs.items():
        if needle in " ".join(args):
            print(text, file=sys.stderr)
elif op == "sandbox provider" and head[2] == "attach":
    sb = state["sandboxes"].get(f"{ws}/{head[3]}")
    if not sb:
        fail("Error: sandbox not found")
    if f"{ws}/{head[4]}" not in state["providers"]:
        fail(f"Error: provider '{head[4]}' not found")
    if head[4] not in sb["providers"]:
        sb["providers"].append(head[4])
elif op == "sandbox provider":
    sb = state["sandboxes"].get(f"{ws}/{head[3]}")
    for p in (sb or {}).get("providers", []):
        print(p)
else:
    fail(f"fake openshell: unsupported {args}", 2)
