{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "saw.redhat.com/v1alpha1"},
    "kind": {"const": "InstallerBOM"},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", "maxLength": 63}}
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["installerVersion", "openshell"],
      "properties": {
        "installerVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "openshell": {
          "type": "object", "additionalProperties": false,
          "required": ["cli", "gateway", "supervisor"],
          "properties": {
            "cli": {"$ref": "#/definitions/component"},
            "gateway": {"$ref": "#/definitions/component"},
            "supervisor": {"$ref": "#/definitions/component"}
          }
        }
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "image"],
      "properties": {
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$", "maxLength": 128},
        "image": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[0-9a-f]{64}$", "maxLength": 512}
      }
    }
  }
}
