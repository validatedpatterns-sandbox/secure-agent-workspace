  "github": {
    "binaries": [
      "/usr/bin/gh",
      "/usr/local/bin/gh",
      "/usr/bin/git",
      "/usr/local/bin/git",
      "/usr/bin/curl",
      "/usr/local/bin/curl"
    ],
    "category": "source_control",
    "credentials": [
      {
        "auth_style": "bearer",
        "description": "GitHub token",
        "env_vars": [
          "GITHUB_TOKEN",
          "GH_TOKEN"
        ],
        "header_name": "authorization",
        "name": "api_token",
        "required": true
      }
    ],
    "description": "GitHub API and Git operations",
    "discovery": {
      "credentials": [
        "api_token"
      ]
    },
    "display_name": "GitHub",
    "endpoints": [
      {
        "access": "read-only",
        "enforcement": "enforce",
        "host": "api-1.github.com",
        "port": 443,
        "protocol": "rest"
      },
      {
        "access": "read-only",
        "enforcement": "enforce",
        "host": "api.github.com",
        "port": 443,
        "protocol": "rest"
      },
      {
        "access": "read-only",
        "enforcement": "enforce",
        "host": "api.github.com",
        "path": "/graphql",
        "port": 443,
        "protocol": "graphql"
      },
      {
        "access": "read-only",
        "enforcement": "enforce",
        "host": "github.com",
        "port": 443,
        "protocol": "rest"
      }
    ],
    "id": "github"
  },
  "gmail": {
    "binaries": [
      "/usr/bin/curl",
      "/usr/local/bin/curl",
      "/usr/bin/node",
      "/usr/bin/node-*",
      "/usr/local/bin/node"
    ],
    "category": "messaging",
    "credentials": [
      {
        "auth_style": "bearer",
        "description": "Gmail OAuth access token (gmail.readonly)",
        "env_vars": [
          "GMAIL_ACCESS_TOKEN"
        ],
        "header_name": "authorization",
        "name": "access_token",
        "refresh": {
          "material": [
            {
              "description": "Google OAuth client ID",
              "name": "client_id",
              "required": true
            },
            {
              "description": "Google OAuth client secret",
              "name": "client_secret",
              "required": true,
              "secret": true
            },
            {
              "description": "Google OAuth refresh token (scope gmail.readonly)",
              "name": "refresh_token",
              "required": true,
              "secret": true
            }
          ],
          "max_lifetime_seconds": 3600,
          "refresh_before_seconds": 300,
          "strategy": "oauth2_refresh_token",
          "token_url": "https://oauth2.googleapis.com/token"
        },
        "required": true
      }
    ],
    "description": "Read-only Gmail API access for governed sandbox agents",
    "discovery": {
      "credentials": [
        "access_token"
      ]
    },
    "display_name": "Gmail",
    "endpoints": [
      {
        "enforcement": "enforce",
        "host": "gmail.googleapis.com",
        "port": 443,
        "protocol": "rest",
        "rules": [
          {
            "allow": {
              "method": "GET",
              "path": "/gmail/v1/users/me/profile"
            }
          },
          {
            "allow": {
              "method": "GET",
              "path": "/gmail/v1/users/me/labels"
            }
          },
          {
            "allow": {
              "method": "GET",
              "path": "/gmail/v1/users/me/messages"
            }
          },
          {
            "allow": {
              "method": "GET",
              "path": "/gmail/v1/users/me/messages/*"
            }
          },
          {
            "allow": {
              "method": "GET",
              "path": "/gmail/v1/users/me/threads"
            }
          },
          {
            "allow": {
              "method": "GET",
              "path": "/gmail/v1/users/me/threads/*"
            }
          }
        ]
      }
    ],
    "id": "gmail"
  },
