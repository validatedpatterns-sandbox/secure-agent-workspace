# Shared namespace: golden image, image builds, governance interceptor.
NS             ?= openshell-agents
BUILD_NS       ?= openshell-agents
QUAY_REPO      ?= quay.io/rh-ai-quickstart
# Images `make images-mirror` mirrors into the internal registry. Only the
# gateway VM disk (golden image) is needed; the VM pulls sandbox and
# NemoClaw CLI images from quay itself.
MIRROR_IMAGES  ?= openshell-gateway
OPENSHELL_VERSION ?= 0.0.116
# OpenShell release the governance interceptor is built from (must match the
# SAW gateways; image-builder-charts/helm/governance-interceptor-image).
OPENSHELL_INTERCEPTOR_REF ?= v0.1.2
OPENSHELL_SAW_NAME ?=
SANDBOX_IMAGE  ?=
CONTAINER_RUNTIME ?= podman
IMAGE_NAME      = $(if $(filter docker,$(CONTAINER_RUNTIME)),openshell-gateway-docker,openshell-gateway)
GOVERNANCE_ENABLED ?= true
PROVIDER       ?=
MODEL          ?=
API_KEY        ?=
ENDPOINT_URL   ?=
# Comma-separated SAW-BOM profiles for saw-create (default: data-science)
PROFILES       ?=
WEB_SEARCH     ?=
GCP_SA_JSON    ?=
OIDC_ISSUER    ?=
OIDC_CLIENT_ID ?= openshell-cli
OIDC_FLOW      ?= browser
OIDC_TOKEN_DIR ?= $(HOME)/.config/openshell/oidc
SSH_KEY_PATH   ?= $(HOME)/.generated-ssh-keys/sandbox-ssh
OWNER          ?=
# Each SAW (user workspace) gets its own namespace.
SAW_NS         ?= saw-$(OPENSHELL_SAW_NAME)
HELM_DIR       := image-builder-charts/helm/
SAW_CHART  := charts/openshell-saw
KEYCLOAK_CHART := charts/openshell-keycloak
# Keycloak (and the RHBK operator) can live in any namespace.
KEYCLOAK_NS    ?= saw-keycloak
KEYCLOAK_REALM ?= openshell
# The Keycloak CR in KEYCLOAK_NS (another name for a Keycloak the cluster already runs)
KEYCLOAK_NAME  ?= openshell-keycloak
# yes/no: let `make keycloak-deploy` import the realm into an existing Keycloak
USE_EXISTING_KEYCLOAK ?=
SCRIPTS_DIR    := scripts
GUI_PORT       ?= 18789
WORKSPACE      ?= default

# Pass values through the environment so spaces and special shell characters
# in credentials do not become parts of a shell command.
export NS BUILD_NS QUAY_REPO MIRROR_IMAGES OPENSHELL_VERSION OPENSHELL_INTERCEPTOR_REF
export OPENSHELL_SAW_NAME SANDBOX_IMAGE CONTAINER_RUNTIME GOVERNANCE_ENABLED
export PROVIDER MODEL API_KEY ENDPOINT_URL PROFILES WEB_SEARCH WEB_SEARCH_API_KEY GCP_SA_JSON
export OIDC_ISSUER OIDC_CLIENT_ID OIDC_FLOW OIDC_TOKEN_DIR SSH_KEY_PATH OWNER OWNER_SUBJECT
export SAW_NS SAW_CHART KEYCLOAK_NS KEYCLOAK_CHART KEYCLOAK_REALM KEYCLOAK_NAME SANDBOX_NAME
export USE_EXISTING_KEYCLOAK SCRIPTS_DIR GUI_PORT WORKSPACE CMD

