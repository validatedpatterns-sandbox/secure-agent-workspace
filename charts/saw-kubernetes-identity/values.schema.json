{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "ownerID": {
      "type": "string"
    },
    "targetNamespace": {
      "type": "string"
    },
    "gateway": {
      "type": "string"
    },
    "serverSans": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
      }
    },
    "gatewayImage": {
      "type": "string"
    },
    "helperImage": {
      "type": "string"
    }
  }
}
