{
  "anthropic": {
    "binaries": [
      "/usr/bin/curl",
      "/usr/local/bin/curl",
      "/usr/bin/node",
      "/usr/bin/node-*",
      "/usr/local/bin/node"
    ],
    "category": "inference",
    "credentials": [
      {
        "auth_style": "header",
        "description": "Anthropic API key",
        "env_vars": [
          "ANTHROPIC_API_KEY"
        ],
        "header_name": "x-api-key",
        "name": "api_key",
        "required": true
      }
    ],
    "description": "Anthropic inference API",
    "discovery": {
      "credentials": [
        "api_key"
      ]
    },
    "display_name": "Anthropic",
    "endpoints": [
      {
        "access": "read-write",
        "enforcement": "enforce",
        "host": "api.anthropic.com",
        "port": 443,
        "protocol": "rest"
      }
    ],
    "id": "anthropic",
    "inference_capable": true
  },
