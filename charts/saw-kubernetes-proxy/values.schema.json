{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ownerID": {
      "type": "string"
    },
    "targetNamespace": {
      "type": "string"
    },
    "gateway": {
      "type": "string"
    },
    "policyConfigMap": {
      "type": "string"
    },
    "policyDigest": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "helperImage": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "credentialSecretNames": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": {
        "type": "string"
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrapEgress",
        "proxyEgress"
      ],
      "properties": {
        "bootstrapEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "to",
              "ports"
            ],
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "minProperties": 1
                }
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "port"
                  ]
                }
              }
            }
          }
        },
        "proxyEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "to",
              "ports"
            ],
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "minProperties": 1
                }
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "port"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
