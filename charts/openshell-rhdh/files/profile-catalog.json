        "inference": {
          "fields": [
            {
              "key": "api_key",
              "kind": "secret",
              "required": true,
              "title": "API key"
            },
            {
              "key": "url",
              "kind": "url",
              "required": true,
              "title": "Endpoint base URL (OpenAI-compatible, ending in /v1)"
            },
            {
              "key": "model",
              "kind": "text",
              "required": true,
              "title": "Model"
            }
          ],
          "provider": "custom-inference",
          "providers": [
            "custom-inference"
          ]
        },
        "web-search": {
          "fields": [
            {
              "key": "api_key",
              "kind": "secret",
              "required": true,
              "title": "API key"
            }
