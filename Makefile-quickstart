sandbox-ui: .check-saw-name ## List the sandbox web UI routes without credentials
	@$(SCRIPTS_DIR)/sandbox-ui.sh

portal-vault-setup: ## Let the self-service portal write users' keys to Vault (policy + role; the imperative job does the same)
	@scripts/portal-vault-setup.sh

saw-gui: .check-saw-name ## Open the NemoClaw web UI
	@$(MAKE) nemoclaw-gui

# --- Governance profiles ---

PROFILE_NAME   ?=
PROFILE_FILE   ?=

##@ Governance

governance-deploy: ## Deploy the policy and interceptor in NS
	@$(SCRIPTS_DIR)/governance-deploy.sh

governance-delete: ## Remove the quickstart policy and interceptor releases
	@$(SCRIPTS_DIR)/governance-delete.sh

governance-profile-list: ## List local profiles, or one gateway's profiles when named
	@NS="$(SAW_NS)" SAW_NAME="$(OPENSHELL_SAW_NAME)" $(SCRIPTS_DIR)/governance-profile.sh list

governance-profile-add: .check-saw-name ## Enable an existing profile (PROFILE_NAME=github)
	@NS="$(SAW_NS)" SAW_NAME="$(OPENSHELL_SAW_NAME)" $(SCRIPTS_DIR)/governance-profile.sh add "$(PROFILE_NAME)"

governance-profile-remove: .check-saw-name ## Disable a provider profile (PROFILE_NAME=github)
	@NS="$(SAW_NS)" SAW_NAME="$(OPENSHELL_SAW_NAME)" $(SCRIPTS_DIR)/governance-profile.sh remove "$(PROFILE_NAME)"

governance-profile-create: .check-saw-name ## Create a profile from YAML (PROFILE_NAME= and PROFILE_FILE=)
	@NS="$(SAW_NS)" SAW_NAME="$(OPENSHELL_SAW_NAME)" $(SCRIPTS_DIR)/governance-profile.sh create "$(PROFILE_NAME)" "$(PROFILE_FILE)"

governance-demo: .check-saw-name ## Run governance interceptor demo
	@$(SCRIPTS_DIR)/demo-governance.sh $(OPENSHELL_SAW_NAME)

# --- APF (Agent Policy Fabric) governance: docs/apf.md ---

APF_SEED ?= $(HOME)/.apf-keys/apf.seed
GHCR_USER ?=

apf-keys: ## Create the APF signing key (seed in APF_SEED, public key in the chart)
	@APF_SEED=$(APF_SEED) $(APF_PYTHON) scripts/apf-bundle.py keygen

apf-bundle: ## Sign charts/governance-policy into the APF bundle (commit it to your deployment branch)
	@APF_SEED=$(APF_SEED) $(APF_PYTHON) scripts/apf-bundle.py build

apf-bundle-check: ## Check the committed APF bundle: hashes, signature, up to date
	@$(APF_PYTHON) scripts/apf-bundle.py verify

governance-apf: ## Quickstart: run APF as the governance interceptor (GHCR_USER=, GHCR_TOKEN= env)
	@NS=$(NS) APF_SEED=$(APF_SEED) GHCR_USER=$(GHCR_USER) PYTHON=$(APF_PYTHON) $(SCRIPTS_DIR)/governance-apf.sh

# --- Test ---

##@ Validation

test: test-installer ## Run local installer, chart, script, portal, and CLI tests

test-deployment: ## Run the live OpenShift deployment test (read docs first)
	@$(SCRIPTS_DIR)/test-deployment.sh

lint: ## Lint charts, shell syntax, and the Make interface
	@for chart in charts/* image-builder-charts/helm/*; do \
		test -f "$$chart/Chart.yaml" || continue; \
		if [ "$$chart" = charts/openshell-saw ]; then \
			helm lint "$$chart" --set sandboxName=lint -f tests/fixtures/saw-network-topology.yaml || exit; \
		else \
			helm lint "$$chart" --set sandboxName=lint || exit; \
		fi; \
		done
	@for script in scripts/*.sh tests/*.sh charts/openshell-saw/files/*.sh \
		charts/openshell-saw/files/installer/*.sh charts/openshell-saw/files/guest/*.sh; do \
		test -f "$$script" || continue; \
		bash -n "$$script" || exit; \
		done
	@if [ "$${CI:-}" = true ]; then \
		python scripts/lint-rendered-shell.py || exit; \
		PYTHONPATH=cli/src$${PYTHONPATH:+:$$PYTHONPATH} \
			python -m pytest -q -p no:cacheprovider tests/scripts/test_make_interface.py || exit; \
	else \
		uv run --locked scripts/lint-rendered-shell.py || exit; \
		PYTHONPATH=cli/src$${PYTHONPATH:+:$$PYTHONPATH} \
			uv run --locked pytest -q -p no:cacheprovider tests/scripts/test_make_interface.py || exit; \
	fi

test-harness-e2e: .check-saw-name ## Verify one SAW's harness bundle on the cluster
	@$(SCRIPTS_DIR)/e2e-harness.sh $(E2E_ARGS)

##@ Teardown

# --- Teardown ---

saw-delete: sandbox-pre-delete ## Uninstall one sandbox and its owned namespace
	@$(SCRIPTS_DIR)/saw-delete.sh

quickstart-delete: ## Remove quickstart Keycloak and image releases
	@$(SCRIPTS_DIR)/quickstart-delete.sh

##@ Status

# --- Status ---

status: ## Show status of all OpenShell resources (every SAW namespace + $(NS))
	@$(SCRIPTS_DIR)/saw-cluster-status.sh

# --- Local Python tests (no cluster needed) ---
TEST_PATHS ?= tests/installer tests/charts tests/scripts tests/portal cli/tests
.PHONY: test-installer
test-installer: ## Run the complete local Python test suite with uv
	@if [ -n "$(PYTHON)" ]; then \
		PYTHONPATH=cli/src$${PYTHONPATH:+:$$PYTHONPATH} $(PYTHON) -m pytest \
			-q -p no:cacheprovider $(TEST_PATHS); \
	else \
		PYTHONPATH=cli/src$${PYTHONPATH:+:$$PYTHONPATH} \
		uv run --locked pytest -q -p no:cacheprovider \
			$(TEST_PATHS); \
	fi

##@ Internal Checks

.check-saw-name:
	@$(SCRIPTS_DIR)/check-saw-name.sh

.check-ssh-key:
	@test -f "$(SSH_KEY_PATH).pub" || { \
		echo "Error: SSH key not found at $(SSH_KEY_PATH).pub"; \
		echo "Generate one with: make ssh-key-generate"; \
		echo "Or set SSH_KEY_PATH to your own key: make saw-create SSH_KEY_PATH=~/.ssh/my_key"; \
		exit 1; \
	}

.check-gateway-ca:
	@test -f "$(HOME)/.config/openshell/gateways/$(OPENSHELL_SAW_NAME)/mtls/ca.crt" || { \
		echo "Error: Gateway CA certificate not found for '$(OPENSHELL_SAW_NAME)'."; \
		echo "Run 'make saw-configure OPENSHELL_SAW_NAME=$(OPENSHELL_SAW_NAME)' first."; \
		exit 1; \
	}

.check-prereqs:
	@$(SCRIPTS_DIR)/prereqs-check.sh
	@$(SCRIPTS_DIR)/check-oidc-ca.sh; rc=$$?; [ $$rc -lt 2 ] || \
		echo "Warning: set oidc.caBundle (above) before make saw-create."

