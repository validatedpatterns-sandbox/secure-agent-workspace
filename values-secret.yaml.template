# Ideally you NEVER COMMIT THESE VALUES TO GIT (although if all passwords are
# automatically generated inside the vault this should not really matter)

# If this is your first time using secrets in Validated Patterns, please check out the following links for a guide:
# https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
# https://validatedpatterns.io/learn/getting-started-secret-management/#_adding_a_secret_to_the_multicloud_gitops_pattern

version: "2.0"

backingStore: vault

secrets:
  # --- SSH key for sandbox provisioning ---
  # Generate with: make generate-keys
  - name: ssh
    fields:
    - name: private_key
      path: ~/.generated-ssh-keys/sandbox-ssh
    - name: public_key
      path: ~/.generated-ssh-keys/sandbox-ssh.pub

  # --- Inference provider ---
  # The default SAW-BOM profile (charts/saw-bom/profiles/data-science) uses
  # NVIDIA (build.nvidia.com): provider `build`. Models default to each
  # sandbox's inference settings. Add a model field only for an override.
  # The installer refuses a key for a different provider; changing providers
  # also requires changing the profile.
  - name: inference
    fields:
    - name: provider
      value: build
    - name: api_key
      path: ~/.nvidia-api-key
  # Custom OpenAI-compatible endpoint (vLLM, Ollama, ...): select the
  # custom-inference profile, name the host in
  # overrides/governance-profiles/custom-inference.yaml, and use these
  # fields instead (docs/custom-inference.md). `provider` is optional; leave
  # it out of a Secret that also serves data-science workspaces.
  #   - name: provider
  #     value: custom-inference
  #   - name: model
  #     value: meta-llama/Llama-3.1-8B-Instruct
  #   - name: url
  #     value: https://<publicly-trusted-host>/v1   # keyed: HTTPS port 443 only
  #     # Keyless alternative: http://vllm.models.svc.cluster.local:8000/v1
  #     # Custom keyed ports and service-CA trust are follow-up #137.
  #   - name: api_key
  #     path: ~/.custom-inference-api-key   # may be empty for a keyless endpoint

  # Optional official APIs: enable each provider and add its name to
  # notebook.providers in charts/saw-bom/profiles/data-science/default.
  # Their models default to notebook.inference.models. To override one,
  # add a model field to that API's Secret; API keys alone use the defaults.
  # - name: inference-openai
  #   fields:
  #   - name: provider
  #     value: openai
  #   - name: api_key
  #     path: ~/.openai-api-key
  # - name: inference-anthropic
  #   fields:
  #   - name: provider
  #     value: anthropic
  #   - name: api_key
  #     path: ~/.anthropic-api-key

  # --- Web search ---
  # The default profile creates a `brave` provider in the default workspace,
  # so this key is required unless web search is off. To omit this entry, run
  # ./pattern.sh make install WEB_SEARCH_ENABLED=false, or set
  # global.webSearch.enabled: false in values-global.yaml (per-user override:
  # webSearch.enabled in overrides/saw-users.yaml). With governance on, the
  # brave profile is served by the governance interceptor.
  - name: web-search
    fields:
    - name: provider
      value: brave
    - name: api_key
      path: ~/.brave-api-key

  # --- APF governance (only with global.governance.engine: apf) ---
  # APF's chart and images are private on ghcr.io: a GitHub user with access
  # to ghcr.io/mkhaas/apf and a token with the read:packages scope. Argo CD
  # pulls the chart and the cluster pulls the images with it.
  # - name: ghcr
  #   fields:
  #   - name: username
  #     value: <github-user>
  #   - name: token
  #     path: ~/.ghcr-token
  # The private half of the key that signed charts/governance-interceptor/
  # files/apf (make apf-keys). APF signs its provenance tokens with it.
  # - name: apf-signing
  #   fields:
  #   - name: seed
  #     path: ~/.apf-keys/apf.seed

  # --- Self-service portal (charts/openshell-rhdh) ---
  # RHDH's Keycloak client secret and session secret, generated on first
  # load. The portal writes each user's own keys under hub/saw-<user>.
  - name: rhdh-oidc
    fields:
    - name: client_secret
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    - name: session_secret
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy

  # --- Per-user Vault prefix (optional) ---
  # Secrets above go to the shared hub prefix (secret/data/hub) and every
  # user's workspace reads them. The saw-users chart cannot create Vault
  # entries. To give one person their own keys, load them here (vaultPrefixes
  # is relative to secret/data) and set that user's vaultPrefix to
  # secret/data/hub/saw-<user>:
  # - name: inference
  #   vaultPrefixes:
  #     - hub/saw-alice
  #   fields:
  #   - name: provider
  #     value: build
  #   - name: api_key
  #     path: ~/.nvidia-api-key

  # Optional personal-assistant credentials for Git-listed users.
  # Use the matching per-user vaultPrefixes (for example hub/saw-dana).
  # The namespace proxy alone mounts the full Secrets; VMs get provider metadata.
  # - name: slack
  #   vaultPrefixes: [hub/saw-dana]
  #   fields:
  #     - {name: bot_token, value: "<static Slack bot token>"}
  #     - {name: provider, value: slack}
  # - name: gmail
  #   vaultPrefixes: [hub/saw-dana]
  #   fields:
  #     - {name: client_id, value: "<Google OAuth client ID>"}
  #     - {name: client_secret, value: "<Google OAuth client secret>"}
  #     - {name: refresh_token, value: "<Google OAuth refresh token>"}
  #     - {name: provider, value: gmail}
