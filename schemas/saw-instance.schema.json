{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "saw.redhat.com/v1alpha1"
    },
    "kind": {
      "const": "SawInstance"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 63
        }
      },
      "required": [
        "name"
      ]
    },
    "spec": {
      "type": "object",
      "required": [
        "ownerSubject",
        "workspaces"
      ],
      "properties": {
        "ownerSubject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "profileRef": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                    "maxLength": 63
                  },
                  "configMapRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                        "maxLength": 63
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "required": [
                  "name",
                  "configMapRef"
                ]
              },
              "credentialBindings": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                  "maxLength": 63
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "secretRef": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                          "maxLength": 63
                        },
                        "key": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*$",
                          "maxLength": 253
                        }
                      },
                      "required": [
                        "name",
                        "key"
                      ]
                    }
                  },
                  "required": [
                    "secretRef"
                  ]
                }
              }
            },
            "required": [
              "profileRef"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
