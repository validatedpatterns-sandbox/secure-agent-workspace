# Ideally you NEVER COMMIT THESE VALUES TO GIT (although if all passwords are
# automatically generated inside the vault this should not really matter)

# If this is your first time using secrets in Validated Patterns, please check out the following links for a guide:
# https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
# https://validatedpatterns.io/learn/getting-started-secret-management/#_adding_a_secret_to_the_multicloud_gitops_pattern

version: "2.0"

backingStore: vault

secrets:
  # --- SSH key for sandbox provisioning ---
  # Generate with: cd quickstart && make generate-keys
  # Then paste the private key below.
  - name: ssh
    fields:
    - name: private_key
      value: null
    - name: public_key
      value: null

  # --- Inference providers (set the one you use) ---

  - name: anthropic
    fields:
    - name: api_key
      value: null

  - name: gemini
    fields:
    - name: api_key
      value: null

  - name: openai
    fields:
    - name: api_key
      value: null

  - name: nvidia
    fields:
    - name: api_key
      value: null

  - name: openrouter
    fields:
    - name: api_key
      value: null

  - name: vertex
    fields:
    - name: sa_json
      value: null

  # --- Web search providers (optional) ---

  - name: tavily
    fields:
    - name: api_key
      value: null

  - name: brave-search
    fields:
    - name: api_key
      value: null
