# Shared namespace: golden image, image builds, governance interceptor.
NS             ?= openshell-agents
BUILD_NS       ?= openshell-agents
# Only an explicit destination opts manual builds into publishing.
ifeq ($(origin PUSH_IMAGE_REPO),undefined)
PUSH_IMAGE_REPO := $(IMAGE_REPO)
endif
export PUSH_IMAGE_REPO
IMAGE_REPO     ?= ghcr.io/validatedpatterns-sandbox
# Images `make images-mirror` mirrors into the internal registry. Only the
# gateway VM disk (golden image) is needed; the VM pulls sandbox and
# NemoClaw CLI images from GHCR itself.
MIRROR_IMAGES  ?= openshell-gateway
# CI publishes latest and sha-<commit>; this is an image tag, not an OpenShell release.
IMAGE_TAG      ?= latest
# OpenShell release the governance interceptor is built from (must match the
# SAW gateways; image-builder-charts/helm/governance-interceptor-image).
OPENSHELL_INTERCEPTOR_REF ?= v0.1.2
OPENSHELL_SAW_NAME ?=
SANDBOX_IMAGE  ?=
CONTAINER_RUNTIME ?= podman
IMAGE_NAME      = $(if $(filter docker,$(CONTAINER_RUNTIME)),openshell-gateway-docker,openshell-gateway)
GOVERNANCE_ENABLED ?= true
# interceptor (OpenShell governance interceptor) or apf (docs/apf.md)
GOVERNANCE_ENGINE ?= interceptor
# Python for the APF bundle tooling (scripts/apf-bundle.py needs cryptography).
APF_PYTHON ?= python3
PROVIDER       ?=
MODEL          ?=
API_KEY        ?=
ENDPOINT_URL   ?=
# Comma-separated SAW-BOM profiles for saw-create (default: data-science)
PROFILES       ?=
WEB_SEARCH     ?=
GCP_SA_JSON    ?=
OIDC_ISSUER    ?=
OIDC_CLIENT_ID ?= openshell-cli
OIDC_FLOW      ?= browser
OIDC_TOKEN_DIR ?= $(HOME)/.config/openshell/oidc
SSH_KEY_PATH   ?= $(HOME)/.generated-ssh-keys/sandbox-ssh
OWNER          ?=
# Each SAW (user workspace) gets its own namespace.
SAW_NS         ?= saw-$(OPENSHELL_SAW_NAME)
HELM_DIR       := image-builder-charts/helm/
SAW_CHART  := charts/openshell-saw
SAW_VALUES_FILE ?=
KEYCLOAK_CHART := charts/openshell-keycloak
# Keycloak (and the RHBK operator) can live in any namespace.
KEYCLOAK_NS    ?= saw-keycloak
KEYCLOAK_REALM ?= openshell
# The Keycloak CR in KEYCLOAK_NS (another name for a Keycloak the cluster already runs)
KEYCLOAK_NAME  ?= openshell-keycloak
DEMO_ENABLED   ?= false
# yes/no: let `make keycloak-deploy` import the realm into an existing Keycloak
USE_EXISTING_KEYCLOAK ?=
SCRIPTS_DIR    := scripts
GUI_PORT       ?= 18789
WORKSPACE      ?= default

# Pass values through the environment so spaces and special shell characters
# in credentials do not become parts of a shell command.
export NS BUILD_NS IMAGE_REPO MIRROR_IMAGES IMAGE_TAG OPENSHELL_INTERCEPTOR_REF
export OPENSHELL_SAW_NAME SANDBOX_IMAGE CONTAINER_RUNTIME GOVERNANCE_ENABLED GOVERNANCE_ENGINE
export PROVIDER MODEL API_KEY ENDPOINT_URL PROFILES WEB_SEARCH WEB_SEARCH_API_KEY GCP_SA_JSON
export OIDC_ISSUER OIDC_CLIENT_ID OIDC_FLOW OIDC_TOKEN_DIR SSH_KEY_PATH OWNER OWNER_SUBJECT
export SAW_NS SAW_CHART SAW_VALUES_FILE KEYCLOAK_NS KEYCLOAK_CHART KEYCLOAK_REALM KEYCLOAK_NAME SANDBOX_NAME
export USE_EXISTING_KEYCLOAK SCRIPTS_DIR GUI_PORT WORKSPACE CMD DASHBOARD

# Pattern install: `./pattern.sh make install GOVERNANCE_ENGINE=apf` selects the
# governance engine for this cluster without editing values-global.yaml. It
# becomes a Pattern extraParameter (global.governance.engine), which the
# operator passes to every application and which overrides values-global.yaml.
# Only an explicit GOVERNANCE_ENGINE does this; otherwise values-global.yaml
# decides. Run make install again with the other engine to switch back.
ifneq ($(findstring $(origin GOVERNANCE_ENGINE),command line environment),)
ifeq ($(filter interceptor apf,$(GOVERNANCE_ENGINE)),)
$(error GOVERNANCE_ENGINE must be interceptor or apf, not "$(GOVERNANCE_ENGINE)")
endif
export EXTRA_HELM_OPTS := $(EXTRA_HELM_OPTS) --set main.extraParameters[0].name=global.governance.engine --set main.extraParameters[0].value=$(GOVERNANCE_ENGINE)
endif

