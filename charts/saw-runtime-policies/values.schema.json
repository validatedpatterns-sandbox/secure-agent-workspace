{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "targetNamespace": {
      "type": "string"
    },
    "gatewayId": {
      "type": "string"
    },
    "gatewayServiceAccount": {
      "type": "string"
    },
    "sandboxServiceAccount": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "container",
        "kata"
      ]
    },
    "workloadRuntimeClassName": {"type": "string"},
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 99
        },
        "egress": {
          "type": "array",
          "maxItems": 99,
          "items": {
            "$ref": "#/definitions/egressRule"
          }
        }
      },
      "required": [
        "egress"
      ]
    },
    "global": {
      "type": "object"
    },
    "sandboxControllerUsername": {
      "type": "string"
    },
    "supervisorImage": {
      "type": "string"
    },
    "runtimeImage": {
      "type": "string"
    },
    "serverTLSSecret": {
      "type": "string"
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "relayID": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "dataMounts": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claimName",
                "mountPath",
                "uid",
                "readOnly"
              ],
              "properties": {
                "claimName": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]*$",
                  "not": {
                    "pattern": "^saw-(gate|audit)-"
                  }
                },
                "mountPath": {
                  "type": "string",
                  "pattern": "^/data(/[a-zA-Z0-9._-]+)*$",
                  "not": {
                    "pattern": "/\\.{1,2}(/|$)"
                  }
                },
                "uid": {
                  "type": "string",
                  "minLength": 1
                },
                "readOnly": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "required": [
          "image",
          "base"
        ],
        "additionalProperties": false
      }
    },
    "supervisorCommand": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preparationImage": {
      "type": "string"
    },
    "forwarderImage": {
      "type": "string"
    }
  },
  "required": [
    "enabled",
    "targetNamespace",
    "gatewayId",
    "gatewayServiceAccount",
    "sandboxServiceAccount",
    "mode",
    "network"
  ],
  "definitions": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "matchExpressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "operator"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "enum": [
                  "In",
                  "NotIn",
                  "Exists",
                  "DoesNotExist"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "matchLabels"
          ]
        },
        {
          "required": [
            "matchExpressions"
          ]
        }
      ]
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "namespaces": {
          "$ref": "#/definitions/selector"
        },
        "pods": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespaceSelector",
            "podSelector"
          ],
          "properties": {
            "namespaceSelector": {
              "$ref": "#/definitions/selector"
            },
            "podSelector": {
              "$ref": "#/definitions/selector"
            }
          }
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portNumber"
      ],
      "properties": {
        "portNumber": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "port"
          ],
          "properties": {
            "protocol": {
              "enum": [
                "TCP",
                "UDP",
                "SCTP"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "to",
        "ports"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/peer"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/port"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
